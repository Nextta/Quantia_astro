---

---

<div
    class="fixed inset-x-0 flex h-7.5 items-center align-middle gap-2 bg-[#2f2f2f] px-2 z-50"
>
    <div id="titlebar" class="flex h-7.5 w-full items-center align-middle">
    </div>
    <!-- cerrar,minimizar,maximizar -->
    <div class="flex items-center align-middle">
        <button
            id="titlebar-minimize"
            type="button"
            aria-label="Minimizar"
            class="flex h-8 w-6 mt-2 items-center justify-center"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                class="text-[#9d8585] hover:text-blue-900 mb-3"
                ><!-- Icon from Material Symbols by Google - https://github.com/google/material-design-icons/blob/master/LICENSE -->
                <path fill="currentColor" d="M4 20v-2h16v2H4Z"></path></svg
            >
        </button>

        <button
            id="titlebar-maximize"
            type="button"
            aria-label="Maximizar"
            class="flex h-10 w-6 mt-1 items-center justify-center"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                class="text-[#9d8585] hover:text-blue-900"
                ><!-- Icon from Material Symbols by Google - https://github.com/google/material-design-icons/blob/master/LICENSE -->
                <path fill="currentColor" d="M4 20V4h16v16Zm2-2h12V6H6ZM6 6v12Z"
                ></path></svg
            >
        </button>

        <!-- <button
      id="titlebar-close"
      type="button"
      aria-label="Cerrar"
      class="flex h-10 w-12 mt-1 items-center justify-center text-red-500 hover:bg-red-500"
    > -->
        <button
            id="titlebar-close"
            type="button"
            aria-label="Cerrar"
            class="flex h-10 w-6 mt-1 items-center justify-center"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                class="text-[#9d8585] hover:text-red-500"
                ><!-- Icon from Material Symbols by Google - https://github.com/google/material-design-icons/blob/master/LICENSE -->
                <path
                    fill="currentColor"
                    d="M6.4 19L5 17.6l5.6-5.6L5 6.4L6.4 5l5.6 5.6L17.6 5L19 6.4L13.4 12l5.6 5.6l-1.4 1.4l-5.6-5.6z"
                ></path></svg
            >
        </button>
    </div>
</div>

<script>
    import { getCurrentWindow } from "@tauri-apps/api/window";

    // when using `"withGlobalTauri": true`, you may use
    // const { getCurrentWindow } = window.__TAURI__.window;

    const appWindow = getCurrentWindow();

    document
        .getElementById("titlebar-minimize")
        ?.addEventListener("click", () => appWindow.minimize());
    document
        .getElementById("titlebar-maximize")
        ?.addEventListener("click", () => appWindow.toggleMaximize());
    document
        .getElementById("titlebar-close")
        ?.addEventListener("click", () => appWindow.close());

    document.getElementById("titlebar")?.addEventListener("mousedown", (e) => {
        if (e.buttons === 1) {
            // Primary (left) button
            e.detail === 2
                ? appWindow.toggleMaximize() // Maximize on double click
                : appWindow.startDragging(); // Else start dragging
        }
    });
</script>
