---
import { Show, UserButton, SignInButton, SignUpButton } from '@clerk/astro/components'

const { title } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
  <main class="login-center">
    <slot />
  </main>
</body>
</html>

<style>
  :global(body) { margin: 0; background: #0b1326; }
  .auth-shell {
    min-height: 100vh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 480px);
    color: #dae2fd;
    font-family: Inter, sans-serif;
  }
  .brand {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(32px, 6vw, 88px);
    background: radial-gradient(circle at 70% 35%, #17334c, #0b1326 65%);
  }
  .logo { color: #7bd0ff; font-size: 28px; font-weight: 800; text-decoration: none; }
  .logo span { display: block; color: #4edea3; font-size: 11px; letter-spacing: .3em; }
  .eyebrow { color: #4edea3; font-size: 12px; letter-spacing: .15em; }
  h1 { font-size: clamp(38px, 5vw, 70px); line-height: 1.1; }
  h1 em { color: #7bd0ff; font-style: normal; }
  .entry { display: grid; place-items: center; padding: 32px; background: #131b2e; }
  .entry-content { width: min(100%, 400px); }
  h2 { font-size: 30px; }
  @media (max-width: 850px) {
    .auth-shell { grid-template-columns: 1fr; }
    .brand { padding: 24px; }
    .brand h1, .brand > p { display: none; }
    .entry { min-height: 80vh; }
  }
  .login-center {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
  box-sizing: border-box;
}
</style>