---
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <!-- Top Navigation Anchor (Suppressed based on Transactional Rule but keeping Identity) -->
  <div
    class="flex items-center justify-center p-0 mt-12 border-0 border-amber-400"
  >
    <!-- Login Card: The Sovereign Architect Style -->
    <!-- border-outline-variant/10 -->
    <div
      class="w-full max-w-[440px] glass-panel rounded-xl p-4 border-0 shadow-[20px_20px_20px_rgba(0,0,0,0.2)] border-blue-500 max-[383px]:p-1.5
        border-0"
    >
      <div class="text-center mb-10">
        <h1
          class="font-headline text-3xl font-bold tracking-tight text-on-surface mb-2"
        >
          Welcome Back
        </h1>
        <p class="text-on-surface-variant text-sm font-light">
          Access your algorithmic architect workspace
        </p>
      </div>
      <!-- space-y-6 -->
      <form class="flex flex-wrap flex-col border-0 gap-4">
        <!-- Google SSO -->
        <!-- border-outline-variant/5 -->
        <button
          class="w-full flex items-center justify-center gap-3 bg-surface-container-high hover:bg-surface-bright text-on-surface font-medium py-3.5 px-4 rounded-lg transition-all duration-300 group border-0"
          type="button"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
              fill="#4285F4"></path>
            <path
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
              fill="#34A853"></path>
            <path
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.26.81-.58z"
              fill="#FBBC05"></path>
            <path
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
              fill="#EA4335"></path>
          </svg>
          <span class="text-sm font-semibold tracking-wide"
            >Sign in with Google</span
          >
        </button>
        <div class="relative flex items-center py-2 border-0">
          <div class="flex-grow border-t border-outline-variant/20"></div>
          <span
            class="flex-shrink mx-4 text-xs font-label uppercase tracking-widest text-on-surface-variant/50"
            >or continue with email</span
          >
          <div class="flex-grow border-t border-outline-variant/20"></div>
        </div>

        <!-- Input Fields -->
        <div class="border-0 flex flex-col">
          <div class="grid border-lime-400">
            <label
              class="text-[10px] font-label font-bold uppercase tracking-[0.1em] text-on-surface-variant px-1 h-5"
              for="email">Email Address</label
            >
            <div class="h-15">
              <input
                class="w-full bg-surface-container-lowest border-none text-on-surface text-sm rounded-lg p-4 focus:ring-2 focus:ring-primary/40 transition-all placeholder:text-on-surface-variant/30"
                id="email"
                placeholder="architect@quantiapro.ai"
                type="email"
              />
            </div>
          </div>
          <div class="flex flex-col flex-wrap border-0">
            <div
              class="flex justify-between items-center px-1 max-[400px]:order-2 max-[400px]:flex-col"
            >
              <label
                class="text-[10px] font-label font-bold uppercase tracking-[0.1em] text-on-surface-variant mt-1.5"
                for="password">Password</label
              >
              <a
                class="text-[10px] font-label font-bold uppercase tracking-[0.05em] text-primary hover:text-secondary transition-colors"
                href="#">Forgot password?</a
              >
            </div>
            <div class="relative max-[400px]:order-1">
              <input
                class="w-full bg-surface-container-lowest border-none text-on-surface text-sm rounded-lg p-4 focus:ring-2 focus:ring-primary/40 transition-all placeholder:text-on-surface-variant/30"
                id="password"
                placeholder="••••••••"
                type="password"
              />
            </div>
          </div>
        </div>
        <!-- Login Button -->
        <button
          class="w-full bg-primary hover:bg-primary-fixed-dim text-on-primary font-bold py-4 rounded-lg transition-all duration-300 shadow-lg shadow-primary/10 active:scale-[0.98] border-0"
          type="submit"
        >
          Login
        </button>
        <p class="text-center text-sm text-on-surface-variant border-0">
          New to the architect suite?
          <a
            class="text-secondary font-semibold hover:underline underline-offset-4 decoration-secondary/30 transition-all"
            href="#">Create an account</a
          >
        </p>
      </form>
    </div>
  </div>
  <!-- Contextual Decorative Elements -->
  <!-- Footer: The Anchor Style -->
  <!-- <footer
      class="w-full bg-surface-dim flex flex-col justify-center items-center px-0 flex-col border-0 mt-20"
    >
    tracking-[0.15em]
      <div
        class="text-[10px] font-label uppercase text-slate-600 mb-4 md:mb-0 max-[430px]:px-0 max-[430px]:pr-14  border-0 flex grow-5 basis-0 
        max-[420px]:pl-17 max-[420px]:h-15
        "
      >
        © 2024 QuantiaPro. All rights reserved.
      </div>
      <div class="flex grow-2  basis-0 gap-6 border-0 border-green-500">
        <a
          class="text-[10px] font-label uppercase tracking-[0.15em] text-slate-600 hover:text-on-surface transition-colors  border-0"
          href="#">Terms of Service</a
        >
        <a
          class="text-[10px] font-label uppercase tracking-[0.15em] text-slate-600 hover:text-on-surface transition-colors  border-0"
          href="#">Privacy Policy</a
        >
        <a
          class="text-[10px] font-label uppercase tracking-[0.15em] text-slate-600 hover:text-on-surface transition-colors  border-0"
          href="#">Contact Support</a
        >
      </div>
    </footer> -->
  <!-- Background Graphics -->
  <!-- <div
      class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none opacity-10"
    >
      Abstract grid pattern for technical feel
      <svg class="absolute w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern
            height="40"
            id="grid"
            patternUnits="userSpaceOnUse"
            width="40"
          >
            <path
              d="M 40 0 L 0 0 0 40"
              fill="none"
              stroke="currentColor"
              stroke-width="0.5"></path>
          </pattern>
        </defs>
        <rect fill="url(#grid)" height="100%" width="100%"></rect>
      </svg>
    </div> -->
  <footer
    class="w-full mt-20 py-8 bg-surface-dim flex flex-col md:flex-row justify-between items-center px-12 z-10"
  >
    <div
      class="text-[10px] font-label uppercase tracking-[0.15em] text-slate-600 mb-4 md:mb-0"
    >
      © 2024 QuantiaPro. All rights reserved.
    </div>
    <div class="flex gap-8">
      <a
        class="text-[10px] font-label uppercase tracking-[0.15em] text-slate-600 hover:text-on-surface transition-colors"
        href="#">Terms of Service</a
      >
      <a
        class="text-[10px] font-label uppercase tracking-[0.15em] text-slate-600 hover:text-on-surface transition-colors"
        href="#">Privacy Policy</a
      >
      <a
        class="text-[10px] font-label uppercase tracking-[0.15em] text-slate-600 hover:text-on-surface transition-colors"
        href="#">Contact Support</a
      >
    </div>
  </footer>
</Layout>
