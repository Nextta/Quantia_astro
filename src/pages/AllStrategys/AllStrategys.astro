---
import Layout from "../../layouts/Layout.astro";
import StrategyCard from "../../components/StrategyCard.astro";
// import { cardsArray } from "../main/Home.astro";
import { strategy1Points } from "../main/Home.astro";
import type { Strategy } from "../../interfaces/strategy";
import type { Props } from "astro/components/ClientRouter.astro";

import { getRankedBacktests } from "../../utils/functionsGeneral";

const rankedBacktests = await getRankedBacktests();
---

<Layout title="Quantia">
  
    <div
      id="strategy-grid"
      class="
        grid
        grid-cols-1
        sm:grid-cols-[repeat(auto-fill,minmax(25rem,30rem))]
        justify-start
        items-stretch
        gap-6

      "
    >
      {
        rankedBacktests.map((backtest, index) => (
          <StrategyCard
            id={backtest.id}
            ranking={index + 1}
            titulo={backtest.titulo}
            tipo={backtest.tipo}
            returnPercent={backtest.returnPercent}
            profitFactor={backtest.profitFactor}
            drawDown={backtest.drawDown}
            points={backtest.points}
          />
        ))
      }

      {
        rankedBacktests.length === 0 && (
          <p class="col-span-full py-10 text-on-surface-variant">
            No hay backtests disponibles.
          </p>
        )
      }
    </div>

</Layout>
