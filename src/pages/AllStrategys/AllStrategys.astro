---
import Layout from "../../layouts/Layout.astro";
import StrategyCard from "../../components/StrategyCard.astro";
// import { cardsArray } from "../main/Home.astro";
import { strategy1Points } from "../main/Home.astro";
import type { Strategy } from "../../interfaces/strategy";
import type { Props } from "astro/components/ClientRouter.astro";

import type { Backtest } from "../../interfaces/backtest";


// const cuenta_data_all, Strategy = cuenta_data
import Database from "better-sqlite3";

const db = new Database("src/data/Qauntia.db");


async function getCards(): Promise<Strategy[]> {
  return db
    .prepare("SELECT * FROM strategies")
    .all() as Strategy[];
}

const cards = await getCards();


---

<Layout>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div
      id="strategy-grid"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
    >
      {cards.map((card) => (
        <StrategyCard
          id={card.id}
          nombre={card.nombre}
          pointsP={strategy1Points} 
          balance={}
        />
      ))}
    </div>
  </div>


</Layout>

