---
import Layout from "../../layouts/Layout.astro";
import MnPer from "../../components/DetailsCompTrade/MnPer.astro";
import ChartArea from "../../components/DetailsCompTrade/ChartArea.astro";
import ExecutionTiming from "../../components/DetailsCompTrade/ExecutionTiming.astro";
import Metrics from "../../components/DetailsCompTrade/Metrics.astro";
import PositionDt from "../../components/DetailsCompTrade/PositionDt.astro";
import ContextStr from "../../components/DetailsCompTrade/ContextStr.astro";


const { id } = Astro.params;
---

<Layout title={`Trade Detail - Trade #${id}`}>
  <!-- Main Workspace -->
  <!-- <main
    class="ml-64 flex-1 flex flex-col h-screen relative bg-surface overflow-y-auto"
  > -->
    <!-- TopNavBar -->
    <!-- Content Canvas -->
    <div class="p-6 space-y-6">
      <!-- Trade Header / Summary Bento -->
      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-8 flex flex-col justify-center">
          <h3
            class="text-3xl font-headline font-black text-white tracking-tight flex items-center gap-3"
          >
            Trade #429 Detail
            <span
              class="text-xs bg-secondary/10 text-secondary border border-secondary/20 px-2 py-0.5 rounded-full font-bold uppercase tracking-wider"
              >Closed/Win</span
            >
          </h3>
          <p class="text-on-surface-variant mt-1 font-medium">
            Strategy: Neural Momentum v4 • BTC-USD-PERP • Oct 14, 2023
          </p>
        </div>
        <MnPer />
      </div>
      <!-- Candlestick Chart Area -->
      <ChartArea />
      <!-- Statistics Panel Bento Grid -->
      <div class="grid grid-cols-4 gap-6">
        <!-- Execution Details -->
        <ExecutionTiming />
        <!-- Metrics & Excursion -->
        <Metrics />
        <!-- Position & Costs -->
        <PositionDt />
         <!-- Placeholder for Future Expansion -->
        </div>
      </div>
      <!-- Notes / Tags / Additional Info Section -->
      <div class="grid grid-cols-12 gap-6">
        <ContextStr />
         <!-- Placeholder for Future Expansion -->
        <div class="col-span-12 lg:col-span-5 flex flex-col gap-4">
          <div
            class="bg-primary/5 rounded-xl p-6 border border-primary/10 flex items-center justify-between"
          >
            <div class="flex items-center gap-4">
              <div
                class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center"
              >
                <span class="material-symbols-outlined text-primary"
                  >verified</span
                >
              </div>
              <div>
                <h6 class="font-headline font-bold text-white">
                  Backtest Fidelity
                </h6>
                <p class="text-xs text-on-surface-variant">
                  Order Book Depth Simulation Active
                </p>
              </div>
            </div>
            <span class="text-xs font-black text-primary">98% Accuracy</span>
          </div>
          <div class="flex gap-4">
            <button
              class="flex-1 bg-surface-container-high hover:bg-surface-bright text-white font-bold py-4 rounded-xl border border-white/5 flex items-center justify-center gap-2 transition-all"
            >
              <span class="material-symbols-outlined">ios_share</span>
              <span>Export Data</span>
            </button>
            <button
              class="flex-1 bg-secondary text-on-secondary font-bold py-4 rounded-xl flex items-center justify-center gap-2 transition-transform active:scale-95 shadow-lg shadow-secondary/10"
            >
              <span class="material-symbols-outlined">replay</span>
              <span>Re-run Test</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  <!-- </main> -->
</Layout>
