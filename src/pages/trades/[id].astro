---
import Layout from "../../layouts/Layout.astro";
import MnPer from "../../components/DetailsCompTrade/MnPer.astro";
import ChartArea from "../../components/DetailsCompTrade/ChartArea.astro";
import ExecutionTiming from "../../components/DetailsCompTrade/ExecutionTiming.astro";


const { id } = Astro.params;
---

<Layout title={`Trade Detail - Trade #${id}`}>
  <!-- Main Workspace -->
  <!-- <main
    class="ml-64 flex-1 flex flex-col h-screen relative bg-surface overflow-y-auto"
  > -->
    <!-- TopNavBar -->
    <!-- Content Canvas -->
    <div class="p-6 space-y-6">
      <!-- Trade Header / Summary Bento -->
      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-8 flex flex-col justify-center">
          <h3
            class="text-3xl font-headline font-black text-white tracking-tight flex items-center gap-3"
          >
            Trade #429 Detail
            <span
              class="text-xs bg-secondary/10 text-secondary border border-secondary/20 px-2 py-0.5 rounded-full font-bold uppercase tracking-wider"
              >Closed/Win</span
            >
          </h3>
          <p class="text-on-surface-variant mt-1 font-medium">
            Strategy: Neural Momentum v4 • BTC-USD-PERP • Oct 14, 2023
          </p>
        </div>
        <MnPer />
      </div>
      <!-- Candlestick Chart Area -->
      <ChartArea />
      <!-- Statistics Panel Bento Grid -->
      <div class="grid grid-cols-4 gap-6">
        <!-- Execution Details -->
        <ExecutionTiming />
        <!-- Metrics & Excursion -->
        <div
          class="col-span-1 bg-surface-container-high rounded-xl p-6 shadow-lg border border-white/5"
        >
          <div class="flex items-center gap-3 mb-6">
            <span class="material-symbols-outlined text-secondary"
              >trending_up</span
            >
            <h5
              class="font-headline font-extrabold uppercase tracking-widest text-xs text-on-surface-variant"
            >
              Trade Excursion
            </h5>
          </div>
          <div class="space-y-6">
            <div>
              <p
                class="text-[10px] text-on-surface-variant uppercase font-bold tracking-widest mb-1"
              >
                Max Favorable (MFE)
              </p>
              <div class="flex items-baseline gap-2">
                <span class="text-lg font-black text-secondary">+$1,580.00</span
                >
                <span class="text-xs text-secondary/60">+4.8%</span>
              </div>
            </div>
            <div>
              <p
                class="text-[10px] text-on-surface-variant uppercase font-bold tracking-widest mb-1"
              >
                Max Adverse (MAE)
              </p>
              <div class="flex items-baseline gap-2">
                <span class="text-lg font-black text-tertiary">-$120.00</span>
                <span class="text-xs text-tertiary/60">-0.3%</span>
              </div>
            </div>
            <div class="pt-4 border-t border-white/5">
              <p
                class="text-[10px] text-on-surface-variant uppercase font-bold tracking-widest mb-1"
              >
                Trade Efficiency
              </p>
              <div
                class="w-full bg-surface-container-low h-1.5 rounded-full mt-2"
              >
                <div class="bg-secondary h-full rounded-full w-[92%]"></div>
              </div>
              <p class="text-right text-[10px] font-bold text-secondary mt-1">
                92.4%
              </p>
            </div>
          </div>
        </div>
        <!-- Position & Costs -->
        <div
          class="col-span-1 bg-surface-container-high rounded-xl p-6 shadow-lg border border-white/5"
        >
          <div class="flex items-center gap-3 mb-6">
            <span class="material-symbols-outlined text-primary-fixed"
              >payments</span
            >
            <h5
              class="font-headline font-extrabold uppercase tracking-widest text-xs text-on-surface-variant"
            >
              Position Details
            </h5>
          </div>
          <div class="space-y-5">
            <div class="flex justify-between">
              <span
                class="text-[10px] text-on-surface-variant uppercase font-bold"
                >Side</span
              >
              <span class="text-xs font-bold text-secondary-fixed"
                >LONG (10x Lev)</span
              >
            </div>
            <div class="flex justify-between">
              <span
                class="text-[10px] text-on-surface-variant uppercase font-bold"
                >Size</span
              >
              <span class="text-xs font-bold text-on-surface">1.25 BTC</span>
            </div>
            <div class="flex justify-between">
              <span
                class="text-[10px] text-on-surface-variant uppercase font-bold"
                >Value</span
              >
              <span class="text-xs font-bold text-on-surface">$34,312.50</span>
            </div>
            <div class="flex justify-between">
              <span
                class="text-[10px] text-on-surface-variant uppercase font-bold"
                >Commissions</span
              >
              <span class="text-xs font-bold text-tertiary">-$14.50</span>
            </div>
            <div class="flex justify-between">
              <span
                class="text-[10px] text-on-surface-variant uppercase font-bold"
                >Slippage</span
              >
              <span class="text-xs font-bold text-tertiary"
                >-$4.20 (0.12 bps)</span
              >
            </div>
            <div class="pt-2">
              <div
                class="bg-surface-container-lowest p-3 rounded-lg border border-white/5"
              >
                <p
                  class="text-[10px] text-on-surface-variant uppercase font-bold tracking-widest mb-1"
                >
                  Exit Reason
                </p>
                <p class="text-xs font-semibold text-primary">
                  Signal: Momentum Fade
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Notes / Tags / Additional Info Section -->
      <div class="grid grid-cols-12 gap-6">
        <div
          class="col-span-12 lg:col-span-7 bg-surface-container-high rounded-xl p-6 border border-white/5"
        >
          <div class="flex items-center justify-between mb-4">
            <h5 class="font-headline font-extrabold text-white">
              Strategy Context
            </h5>
            <button class="text-xs text-primary font-bold hover:underline"
              >View Journal</button
            >
          </div>
          <p class="text-on-surface-variant text-sm leading-relaxed italic">
            "The entry was triggered by a 15-minute bullish engulfing candle
            coupled with an RSI breakout above 55. High volume confirm on
            Binance Spot data. Price held above VWAP throughout the duration.
            Exit triggered by MACD bearish crossover on the 5-minute timeframe.
            Manual intervention: None."
          </p>
          <div class="flex gap-2 mt-4">
            <span
              class="px-3 py-1 bg-surface-container-lowest text-xs font-bold rounded-full text-on-surface-variant"
              >#HighVolume</span
            >
            <span
              class="px-3 py-1 bg-surface-container-lowest text-xs font-bold rounded-full text-on-surface-variant"
              >#BullishEngulfing</span
            >
            <span
              class="px-3 py-1 bg-surface-container-lowest text-xs font-bold rounded-full text-on-surface-variant"
              >#Scalp</span
            >
          </div>
        </div>
        <div class="col-span-12 lg:col-span-5 flex flex-col gap-4">
          <div
            class="bg-primary/5 rounded-xl p-6 border border-primary/10 flex items-center justify-between"
          >
            <div class="flex items-center gap-4">
              <div
                class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center"
              >
                <span class="material-symbols-outlined text-primary"
                  >verified</span
                >
              </div>
              <div>
                <h6 class="font-headline font-bold text-white">
                  Backtest Fidelity
                </h6>
                <p class="text-xs text-on-surface-variant">
                  Order Book Depth Simulation Active
                </p>
              </div>
            </div>
            <span class="text-xs font-black text-primary">98% Accuracy</span>
          </div>
          <div class="flex gap-4">
            <button
              class="flex-1 bg-surface-container-high hover:bg-surface-bright text-white font-bold py-4 rounded-xl border border-white/5 flex items-center justify-center gap-2 transition-all"
            >
              <span class="material-symbols-outlined">ios_share</span>
              <span>Export Data</span>
            </button>
            <button
              class="flex-1 bg-secondary text-on-secondary font-bold py-4 rounded-xl flex items-center justify-center gap-2 transition-transform active:scale-95 shadow-lg shadow-secondary/10"
            >
              <span class="material-symbols-outlined">replay</span>
              <span>Re-run Test</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  <!-- </main> -->
</Layout>
