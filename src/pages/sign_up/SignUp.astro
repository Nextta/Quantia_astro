---
import Layout from "../../layouts/Layout.astro";
import LayoutOnlyBar from "../../layouts/LayoutOnlyBar.astro";
import global from "../../styles/global.css";
---

<LayoutOnlyBar>
  <!-- overflow-hidden -->

  <!-- Ambient Decorative Elements -->
  <!-- overflow-y-auto -->
  <!-- px-4 max-[520px]:px-0 -->
  <div
    class="grid h-dvh grid-rows-[minmax(0,1fr)_70px] overflow-hidden border-0"
  >
    <main
      class="min-h-0 grid place-items-center overflow-hidden border-0 border-red-500"
    >
      <div class="min-h-0 max-h-full grid place-items-center overflow-hidden p-4
      rounded-2xl shadow-[20px_20px_20px_rgba(0,0,0,0.2)] glass-panel border-0
      border-blue-500" >
      <h1
        class="text-3xl font-extrabold tracking-tight text-on-surface font-headline mb-3 max-[390px]:text-2xl"
      >
        Begin Your Sovereignty
      </h1>
      <p class="text-on-surface-variant font-body text-sm tracking-wide">
        Architect your quantitative legacy with precision.
      </p>

      <form class="space-y-4 border-0">
        <div class="space-y-3 border-0 border-amber-400">
          <div class="space-y-1.5 border-0">
            <!-- div de full name -->
            <label
              class="block text-xs font-medium uppercase tracking-widest text-on-surface-variant font-label ml-1"
              for="full-name">Full Name</label
            >
            <div class="relative">
              <input
                class="w-full bg-surface-container-lowest border-none focus:ring-1 focus:ring-primary/40 rounded-lg py-2.5 pl-2 pr-4 text-on-surface placeholder:text-outline/40 transition-all font-body"
                id="full-name"
                name="full-name"
                placeholder="Full Name"
                type="text"
              />
            </div>
          </div>
          <div class="space-y-1.5">
            <label
              class="block text-xs font-medium uppercase tracking-widest text-on-surface-variant font-label ml-1"
              for="email">Email Address</label
            >
            <div class="relative">
              <input
                class="w-full bg-surface-container-lowest border-none focus:ring-1 focus:ring-primary/40 rounded-lg py-2.5 pl-2 pr-4 text-on-surface placeholder:text-outline/40 transition-all font-body"
                id="email"
                name="email"
                placeholder="Mail Address"
                type="email"
              />
            </div>
          </div>
          <div class="space-y-1.5">
            <label
              class="block text-xs font-medium uppercase tracking-widest text-on-surface-variant font-label ml-1"
              for="password">Password</label
            >
            <div class="relative">
              <input
                class="w-full bg-surface-container-lowest border-none focus:ring-1 focus:ring-primary/40 rounded-lg py-2.5 pl-2 pr-4 text-on-surface placeholder:text-outline/40 transition-all font-body"
                id="password"
                name="password"
                placeholder="••••••••••••"
                type="password"
              />
            </div>
          </div>
        </div>
        <div class="flex items-start gap-3 mt-4">
          <div class="flex items-center h-5">
            <input
              class="h-4 w-4 rounded border-outline-variant bg-surface-container-lowest text-secondary focus:ring-secondary/20 cursor-pointer"
              id="terms"
              name="terms"
              type="checkbox"
            />
          </div>
          <label
            class="text-xs text-on-surface-variant leading-relaxed font-body"
            for="terms"
          >
            I acknowledge the <a
              class="text-primary hover:underline underline-offset-4"
              href="#">Terms of Service</a
            > and the <a
              class="text-primary hover:underline underline-offset-4"
              href="#">Privacy Architecture</a
            >.
          </label>
        </div>
        <a href=`/main/Home/`>
          <button
            class="w-full
            growth-gradient
            text-on-secondary-container
            bg-primary hover:bg-primary-fixed-dim text-on-primary font-headline
            font-bold
            py-3
            rounded-lg
            shadow-lg
            hover:shadow-secondary/10
            transition-all
            active:scale-[0.98]
            duration-200
            mt-2
            uppercase
            tracking-tighter"
            type="button"
          >
            Create Account
          </button>
        </a>
      </form>

      <div class="relative my-4">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-outline-variant/10"></div>
        </div>
        <div
          class="relative flex justify-center text-xs uppercase tracking-widest font-label"
        >
          <span class="px-4 text-on-surface-variant">Or leverage SSO</span>
        </div>
      </div>
      <a href=`/main/Home/`>
        <button
          class="w-full flex items-center justify-center gap-3 bg-surface-container-high hover:bg-surface-bright text-on-surface font-medium py-3.5 px-4 rounded-lg transition-all duration-300 group border-0"
          type="button"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
              fill="#4285F4"></path>
            <path
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
              fill="#34A853"></path>
            <path
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.26.81-.58z"
              fill="#FBBC05"></path>
            <path
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
              fill="#EA4335"></path>
          </svg>
          <span class="text-sm font-semibold tracking-wide"
            >Sign in with Google</span
          >
        </button>
      </a>
      <div class="text-center">
        <p class="text-sm text-on-surface-variant font-body">
          Already have an account?
          <a
            class="text-primary font-semibold hover:text-secondary-fixed transition-colors ml-1"
            href=`/login/LoginPage/`>Log in</a
          >
        </p>
      </div>
    </main>
    <footer
      class="w-full border-0 border-amber-300 h-[70px] items-center justify-center flex max-[400px]:mt-4.5"
    >
      <div
        class="text-[10px] uppercase tracking-[0.1em] font-label text-slate-500 mb-4 md:mb-0"
      >
        © 2024 QuantiaPro. All rights reserved.
      </div>
      <div class="flex gap-8">
        <a
          class="ml-4 text-[10px] uppercase tracking-[0.1em] font-label text-slate-600 hover:text-slate-300 transition-colors"
          href="#">Terms of Service</a
        >
        <a
          class="text-[10px] uppercase tracking-[0.1em] font-label text-slate-600 hover:text-slate-300 transition-colors"
          href="#">Privacy Policy</a
        >
        <a
          class="text-[10px] uppercase tracking-[0.1em] font-label text-slate-600 hover:text-slate-300 transition-colors"
          href="#">Contact Support</a
        >
      </div>
    </footer>
  </div>
</LayoutOnlyBar>
