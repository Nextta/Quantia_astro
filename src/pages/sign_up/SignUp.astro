---
import Layout from "../../layouts/Layout.astro";
import LayoutOnlyBar from "../../layouts/LayoutOnlyBar.astro";
import global from "../../styles/global.css";
---

<LayoutOnlyBar>
  <!-- overflow-hidden -->
  <main
    class="grid h-dvh grid-rows-[minmax(0,1fr)_auto] border-4 border-red-500 place-items-center"
  >
    <!-- Ambient Decorative Elements -->
    <!-- overflow-y-auto -->
    <div
      class="min-h-0 grid place-items-center overflow-hidden border-4 border-blue-700 px-4 max-[520px]:px-0"
    >
      <!-- <div
        class="absolute top-1/4 -left-20 w-96 h-96 bg-primary/10 rounded-full blur-[120px] pointer-events-none"
      >
      </div>
      <div
        class="absolute bottom-1/4 -right-20 w-96 h-96 bg-secondary/5 rounded-full blur-[120px] pointer-events-none"
      >
      </div> -->
      <!-- <div class="min-h-0 w-full overflow-y-auto border-4 border-blue-700 px-4 py-6"> -->
      <div
        class="w-full max-w-[480px] glass-panel p-5 md:p-6 rounded-xl shadow-2xl border-0 border-outline-variant/10"
      >
        <!-- <div
        class="glass-panel p-8 md:p-12 rounded-xl shadow-2xl border-6 border-outline-variant/10"
      > -->
        <div class="mb-4 text-center">
          <!-- <div
        class="glass-panel p-8 md:p-12 rounded-xl shadow-2xl border border-outline-variant/10"
      > -->

          <h1
            class="text-3xl font-extrabold tracking-tight text-on-surface font-headline mb-3 max-[390px]:text-2xl"
          >
            Begin Your Sovereignty
          </h1>
          <p class="text-on-surface-variant font-body text-sm tracking-wide">
            Architect your quantitative legacy with precision.
          </p>
        </div>
        <form class="space-y-4">
          <div class="space-y-3">
            <div class="space-y-1.5">
              <label
                class="block text-xs font-medium uppercase tracking-widest text-on-surface-variant font-label ml-1"
                for="full-name">Full Name</label
              >
              <div class="relative">
                <span
                  class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-on-surface-variant text-lg"
                  data-icon="person">person</span
                >
                <input
                  class="w-full bg-surface-container-lowest border-none focus:ring-1 focus:ring-primary/40 rounded-lg py-2.5 pl-12 pr-4 text-on-surface placeholder:text-outline/40 transition-all font-body"
                  id="full-name"
                  name="full-name"
                  placeholder="Leonardo Fibonacci"
                  type="text"
                />
              </div>
            </div>
            <div class="space-y-1.5">
              <label
                class="block text-xs font-medium uppercase tracking-widest text-on-surface-variant font-label ml-1"
                for="email">Email Address</label
              >
              <div class="relative">
                <span
                  class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-on-surface-variant text-lg"
                  data-icon="alternate_email">alternate_email</span
                >
                <input
                  class="w-full bg-surface-container-lowest border-none focus:ring-1 focus:ring-primary/40 rounded-lg py-2.5 pl-12 pr-4 text-on-surface placeholder:text-outline/40 transition-all font-body"
                  id="email"
                  name="email"
                  placeholder="architect@quantia.pro"
                  type="email"
                />
              </div>
            </div>
            <div class="space-y-1.5">
              <label
                class="block text-xs font-medium uppercase tracking-widest text-on-surface-variant font-label ml-1"
                for="password">Password</label
              >
              <div class="relative">
                <span
                  class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-on-surface-variant text-lg"
                  data-icon="lock">lock</span
                >
                <input
                  class="w-full bg-surface-container-lowest border-none focus:ring-1 focus:ring-primary/40 rounded-lg py-2.5 pl-12 pr-4 text-on-surface placeholder:text-outline/40 transition-all font-body"
                  id="password"
                  name="password"
                  placeholder="••••••••••••"
                  type="password"
                />
              </div>
            </div>
          </div>
          <div class="flex items-start gap-3 mt-4">
            <div class="flex items-center h-5">
              <input
                class="h-4 w-4 rounded border-outline-variant bg-surface-container-lowest text-secondary focus:ring-secondary/20 cursor-pointer"
                id="terms"
                name="terms"
                type="checkbox"
              />
            </div>
            <label
              class="text-xs text-on-surface-variant leading-relaxed font-body"
              for="terms"
            >
              I acknowledge the <a
                class="text-primary hover:underline underline-offset-4"
                href="#">Terms of Service</a
              > and the <a
                class="text-primary hover:underline underline-offset-4"
                href="#">Privacy Architecture</a
              >.
            </label>
          </div>

          <button
            class="w-full 
            growth-gradient 
            text-on-secondary-container 
            bg-gradient-to-r from-emerald-400 to-emerald-800
            font-headline 
            font-bold 
            py-3 
            rounded-lg 
            shadow-lg 
            hover:shadow-secondary/10 
            transition-all 
            active:scale-[0.98] 
            duration-200 
            mt-2 
            uppercase 
            tracking-tighter"
            type="button"
          >
            Create Account
          </button>
        </form>
        <div class="relative my-4">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-outline-variant/10"></div>
          </div>
          <div
            class="relative flex justify-center text-xs uppercase tracking-widest font-label"
          >
            <span class="bg-surface-container-high px-4 text-on-surface-variant"
              >Or leverage SSO</span
            >
          </div>
        </div>
        <button
          class="
          w-full 
          bg-surface-container-highest 
          border 
          border-outline-variant/20 
          hover:bg-surface-bright 
          
          transition-colors 
          text-on-surface 
          font-body font-medium 
          py-2.5 
          rounded-lg 
          flex items-center 
          justify-center 
          gap-3"
        >
          <img
            alt="Google Logo"
            class="w-5 h-5"
            data-alt="minimalist google logo with standard colors on a dark background"
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuB8dWYN-Y9o6mDb_QYJ10QHk4m4Z9XBeXXBEwtzsNHyEbdGaE15S-wqDIDvKI2qGpHRvNQMK5nATd5obKufXlyOEBqEdjRkcZWeOrSO7cMzjUjgTheuFhbcS8USz-QsmWWh6c4LwDRuqWfv2oSUGF08pwj5YDB2tnJFjQ6cUelJcmIv1etXQjNNMZ3gBRwOvtv4ecW8YXAldxR0mqGcH1_2TMkWTC5ys_dDDxZbgZGQfJe2EkvfrxaS1D4hRqoJ7d5i6IbR741L2t_6"
          />
          Sign up with Google
        </button>
        <div class="text-center">
          <p class="text-sm text-on-surface-variant font-body">
            Already have an account?
            <a
              class="text-primary font-semibold hover:text-secondary-fixed transition-colors ml-1"
              href="#">Log in</a
            >
          </p>
        </div>
      </div>
      <!-- <div
        class="absolute top-1/4 -left-20 w-96 h-96 bg-primary/10 rounded-full blur-[120px] pointer-events-none"
      >
      </div>
      <div
        class="absolute bottom-1/4 -right-20 w-96 h-96 bg-secondary/5 rounded-full blur-[120px] pointer-events-none"
      >
      </div> -->
    </div>
    <!-- border-slate-800/20 border-t-->
    <!-- <footer
      class="w-full py-6 flex flex-col md:flex-row justify-center items-center px-12  bg-[#0b1326] mt-auto border-4 border-red-600"
    > -->
    <footer
      class="w-full shrink-0 border-0 border-amber-300 h-[70px] items-center justify-center flex"
    >
      <div
        class="text-[10px] uppercase tracking-[0.1em] font-label text-slate-500 mb-4 md:mb-0"
      >
        © 2024 QuantiaPro. All rights reserved.
      </div>
      <div class="flex gap-8">
        <a
          class="ml-4 text-[10px] uppercase tracking-[0.1em] font-label text-slate-600 hover:text-slate-300 transition-colors"
          href="#">Terms of Service</a
        >
        <a
          class="text-[10px] uppercase tracking-[0.1em] font-label text-slate-600 hover:text-slate-300 transition-colors"
          href="#">Privacy Policy</a
        >
        <a
          class="text-[10px] uppercase tracking-[0.1em] font-label text-slate-600 hover:text-slate-300 transition-colors"
          href="#">Contact Support</a
        >
      </div>
    </footer>
  </main>
</LayoutOnlyBar>
