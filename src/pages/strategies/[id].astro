<Layout>
  <!-- Main Content -->
  <!-- <main class="pt-24 pb-12 ml-16 md:ml-64 px-8 min-h-screen"> -->
  <!-- Header Info -->
  <div class="flex flex-col md:flex-row justify-between items-end mb-8 gap-4">
    <div class="border-0">
      <nav class="flex text-xs text-on-surface-variant mb-2 gap-2 font-label">
        <span>Performance Report</span>
        <span>/</span>
        <span class="text-primary">Quantia Obsidian v4.2</span>
      </nav>
      <h1
        class="text-4xl font-extrabold font-headline tracking-tighter text-slate-50"
      >
        Reporte de Desempeño
      </h1>
    </div>
    <div class="flex gap-4">
      <div class="bg-surface-container-low px-4 py-2 rounded-xl">
        <span
          class="block text-[10px] text-on-surface-variant uppercase tracking-widest font-bold"
          >Descargar</span
        >
        <div class="mt-1 flex items-center gap-2">
          <span class="text-sm font-semibold">Reporte</span>
          <div class="flex">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              ><path
                fill="currentColor"
                d="M12 4v12.25L17.25 11l.75.66l-6.5 6.5l-6.5-6.5l.75-.66L11 16.25V4zM3 19h1v2h15v-2h1v3H3z"
              ></path></svg
            >
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Hero Section: Bento Grid -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 mb-8">
    <!-- Equity Curve -->
    <CurveDetail />

    <!-- Key Ratios -->
    <div class="md:col-span-4 flex flex-col gap-6 border-3">
      {
        backtestC ? (
          <>
            <InfoBoxDetail
              title="Risk of ruin"
              risk_of_ruin={backtestC?.estrategia.id ?? 0}
            />
          </>
        ) : (
          <p class="text-red-400">No se encontró el resultado</p>
        )
      }{
        (
          <FactorBox
            factor1={"Recovery Factor"}
            factor2={"Profit Factor"}
            recoveryFactor={Math.round(backtestC?.estrategia.id * 100) / 100}
            profitFactor={Math.round(backtestC?.estrategia.id * 100) / 100}
          />
        )
      }
    </div>
  </div>
  <!-- Detailed Metrics Grids -->
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-8">
    <FourMetrics
      parametro1="Total return"
      parametro2="Best Month"
      parametro3="Worst Month"
      parametro4="Market time"
      title="Overall returns"
      parametro1Value={Math.round(backtestC?.estrategia.id * 100) / 100}
      parametro2Value={Math.round(backtestC?.estrategia.id * 100) / 100}
      parametro3Value={Math.round(backtestC?.estrategia.id * 100) / 100}
      parametro4Value={Math.round(backtestC?.estrategia.id * 100) / 100}
    />
    <FourMetrics
      parametro1="Max. Drawdown"
      parametro2="Ulcer Index"
      parametro3="Risk of ruin"
      parametro4="Volatilidad anual"
      title="Overall returns"
      parametro1Value={Math.round(backtestC?.estrategia.id * 100) / 100}
      parametro2Value={Math.round(backtestC?.estrategia.id * 100) / 100}
      parametro3Value={Math.round(backtestC?.estrategia.id * 100) / 100}
      parametro4Value={Math.round(backtestC?.estrategia.id * 100) / 100}
    />
    <FourMetrics
      parametro1="Skew ratio"
      parametro2="Kurtosis ratio"
      parametro3="Risk of ruin"
      parametro4="Kelly Criterion"
      title="Overall returns"
      parametro1Value={Math.round(backtestC?.estrategia.id)}
      parametro2Value={Math.round(backtestC?.estrategia.id * 100) / 100}
      parametro3Value={Math.round(backtestC?.estrategia.id) / 100}
      parametro4Value={Math.round(backtestC?.estrategia.id * 100) / 100}
    />
    <FourMetrics
      parametro1="Número de trades"
      parametro2="Win %"
      parametro3="Avg Win/Loss"
      parametro4="R_expectancy"
      title="Overall returns"
      parametro1Value={Math.round(backtestC?.estrategia.id * 100) / 100}
      parametro2Value={Math.round(backtestC?.estrategia.id * 100) / 100}
      parametro3Value={Math.round(backtestC?.estrategia.id * 100) / 100}
      parametro4Value={Math.round(backtestC?.estrategia.id) / 100}
    />
  </div>
  <!-- Heatmap Section -->
  <HeatMap />
  <!-- Comparative Charts & Histograms -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <BarGraph />
    <ReturnDistribution />
    <StrVSBench />
  </div>
  <!-- Recent Activity Log Table -->
  <TradesList tradesPerPage={10} trades={allTrades} id={1} />
  <!-- System Footer -->
  <footer
    class="border-surface-container-high flex flex-col md:flex-row justify-between items-start gap-8 opacity-60"
  >
    <GlosaryDetail />
  </footer>
  <!-- </main> -->
  <!-- Contextual FAB (Hidden on details per mandate, but included for complete shell logic if needed on other screens) -->
  <!-- Suppressed: Shell Visibility Rule -->

  <div id="backtest" data-id={idActual}>
    <p id="backtest-status">Cargando backtest...</p>
  </div>
</Layout>

<script>
  import { isTauri } from "@tauri-apps/api/core";

  console.log("¿Tauri?", isTauri());
  import { invoke } from "@tauri-apps/api/core";
  import type { Backtest } from "../../interfaces/backtest";

  const container = document.querySelector<HTMLElement>("#backtest");
  const status = document.querySelector<HTMLElement>("#backtest-status");


  async function cargarBacktest() {
    if (!container || !status) return;

    try {
      const id = Number(container.dataset.id);

      const backtest = await invoke<Backtest>("get_backtest", { id });

      console.log("Backtest:", backtest);

      status.textContent = "Backtest cargado";
    } catch (error) {
      console.error("Error cargando backtest:", error);
      status.textContent = "No se pudo cargar el backtest";
    }
  }

  cargarBacktest();

  
</script>
