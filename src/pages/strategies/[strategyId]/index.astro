---
import Layout from "../../../layouts/Layout.astro";
import CurveDetail from "../../../components/DetailsComponentsStr/CurveDetail.astro";
import InfoBoxDetail from "../../../components/DetailsComponentsStr/InfoBoxDetail.astro";
import FactorBox from "../../../components/DetailsComponentsStr/FactorBox.astro";
import FourMetrics from "../../../components/DetailsComponentsStr/FourMetrics.astro";
import HeatMap from "../../../components/DetailsComponentsStr/HeatMap.astro";
import BarGraph from "../../../components/DetailsComponentsStr/BarGraph.astro";
import ReturnDistribution from "../../../components/DetailsComponentsStr/ReturnDistribution.astro";
import StrVSBench from "../../../components/DetailsComponentsStr/StrVSBench.astro";
import TradesList from "../../../components/DetailsComponentsStr/TradesList.astro";
import GlosaryDetail from "../../../components/DetailsComponentsStr/GlosaryDetail.astro";
//Save
import type { Trade } from "../../../interfaces/trades";
//Downloander------------------------------------------------------------------------------------------->>>>>>>
import DownloadReportBttn from "../../../components/DetailsComponentsStr/DownloadReportBttn.astro";
import type { PerformanceReportPdf } from "../../../utils/generatePDF";
//Downloander-------------------------------------------------------------------------------------------<<<<<<<
import {
  getOneBacktest,
  getResults,
  getTrades,
} from "../../../utils/functionsGeneral";
import type { Backtest } from "../../../interfaces/backtest";
const { strategyId } = Astro.params;

const idActual = Number(strategyId);

if (!Number.isInteger(idActual) || idActual <= 0) {
  return Astro.redirect("/strategies");
}

const results = await getResults(idActual);
const trades: Trade[] = await getTrades(idActual);
const backtest: Backtest = await getOneBacktest(idActual);


let totalReturnV;
let bestMonthV;
let worstMonthV;
let marketTimeV;

let maxDrawDownV;
let ulcerIndexV;
let riskOfRuin1V;
let volatilidadAnualV;

let skewRatioV;
let kurtosisRatioV;
let riskOfRuin2V;
let kellyCriterionV;

let numeroDeTradesV;
let winV;
let avgWinLossV;
let rExpectancyV;

const arrProps = results.flatMap((rt) => {
  
  totalReturnV = Math.round(rt.retorno * 100) / 100 + " USD";
  bestMonthV = Math.round(rt.best_month * 100) / 100 + " USD";
  worstMonthV = Math.round(rt.worst_month * 100) / 100 + " USD";
  marketTimeV = Math.round(rt.time_in_market * 100) / 100 + " %";

  maxDrawDownV = Math.round(rt.max_drawdown * 100) / 100 + " %"; //Rojo en negativo, siempre rojo
  ulcerIndexV = Math.round(rt.ulcer_index * 100) / 100 + " %";
  riskOfRuin1V = Math.round(rt.risk_of_ruin * 100) / 100 + " %";
  volatilidadAnualV = Math.round(rt.volatility_ann * 100) / 100 + " %";

  skewRatioV = Math.round(rt.skew_ratio * 100) / 100 + " %";
  kurtosisRatioV = Math.round(rt.kurtosis_ratio * 100) / 100 + " %";
  riskOfRuin2V = Math.round(rt.risk_of_ruin * 100) / 100 + " %";
  kellyCriterionV = Math.round(rt.kelly_criterion * 100) / 100 + " %";

  numeroDeTradesV = Math.round(rt.n_trades) + "";
  winV = Math.round(rt.wins_percentage * 100) / 100 + " %";
  avgWinLossV = Math.round(rt.avg_win_loss_ratio * 100) / 100 + "";
  rExpectancyV = Math.round(rt.r_expectancy * 100) / 100 + " R";

  return {
    totalReturnV,
    bestMonthV,
    worstMonthV,
    marketTimeV,

    maxDrawDownV,
    ulcerIndexV,
    riskOfRuin1V,
    volatilidadAnualV,

    skewRatioV,
    kurtosisRatioV,
    riskOfRuin2V,
    kellyCriterionV,

    numeroDeTradesV,
    winV,
    avgWinLossV,
    rExpectancyV,
  };
});

const pdfReport: PerformanceReportPdf = {
  title: String(backtest.titulo ?? ""),
  initialBalance: Number(backtest.balance ?? 0),

  trades: trades.map((trade) => ({
    t0: trade.t0,
    tipo: String(trade.tipo ?? ""),
    precio_entrada: Number(trade.precio_entrada ?? ""),
    precio_cierre: Number(trade.precio_cierre ?? ""),
    pl: Number(trade.pl ?? 0),
    duracion_horas: String(trade.duracion_horas  ?? "" ),
  })),
};

---

<Layout>
  <div id="pdf-dashboard">
    <section data-pdf-section class="flow-root">
  <!-- Main Content -->
  <!-- <main class="pt-24 pb-12 ml-16 md:ml-64 px-8 min-h-screen"> -->
  <!-- Header Info -->
  <div class="flex flex-col md:flex-row justify-between items-end mb-8 gap-4">
    <div class="border-0">
      <nav class="flex text-xs text-on-surface-variant mb-2 gap-2 font-label">
        <span>Performance Report</span>
        <span>/</span>
        <span class="text-primary">{backtest.titulo}</span>
      </nav>
      <h1
        class="text-4xl font-extrabold font-headline tracking-tighter text-slate-50"
      >
        Reporte de Desempeño
      </h1>
    </div>
    <div class="flex gap-4">
      
      <DownloadReportBttn report={pdfReport}/>
    </div>
  </div>
  <!-- Hero Section: Bento Grid -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 mb-8">
    <!-- Equity Curve - Gráfica TV -->
     {
        results.map((rt) => (
    <CurveDetail trades={trades} initialBalance={backtest.balance} returnUSD={Math.round(rt.retorno * 100) / 100} returnPercent={Math.round(rt.return_percent * 100) / 100} />
     ))
     }

    <!-- Key Ratios -->
    <div class="md:col-span-4 flex flex-col gap-6">
      {
        results.map((rt) => (
          <FactorBox
            factor1={"Recovery Factor"}
            factor2={"Profit Factor"}
            recoveryFactor={Math.round(rt?.recovery_factor * 100) / 100}
            profitFactor={Math.round(rt?.profit_factor * 100) / 100}
          />
        
      
      
          <InfoBoxDetail
            title={"Sharpe Ratio"}
            value={String(Math.round(rt?.sharpe_ratio * 100) / 100)}
          />
        
      
      
        //Colocar porcentaje en maxDrawDown
          
      ))}
      {
        arrProps.map((rt) => (
          <InfoBoxDetail
            title={"MAX DRAWDOWN"}
            value={rt.maxDrawDownV}
          />
        ))
      }
    </div>
  </div>
  </section>
  <!-- Detailed Metrics Grids -->
   <section data-pdf-section class="flow-root">
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4
   gap-6 mb-8">
    {
      arrProps.map((rt) => (
        <FourMetrics
          parametro1="Total return"
          parametro2="Best Month"
          parametro3="Worst Month"
          parametro4="Market time"
          title="Overall returns"
          parametro1Value={rt.totalReturnV}
          parametro2Value={rt.bestMonthV}
          parametro3Value={rt.worstMonthV}
          parametro4Value={rt.marketTimeV}
        />

        <FourMetrics
          parametro1="Max. Drawdown"
          parametro2="Ulcer Index"
          parametro3="Risk of ruin"
          parametro4="Volatilidad anual"
          title="Risk metrics"
          parametro1Value={rt.maxDrawDownV}
          parametro2Value={rt.ulcerIndexV}
          parametro3Value={rt.riskOfRuin1V}
          parametro4Value={rt.volatilidadAnualV}
        />

        <FourMetrics
          parametro1="Skew ratio"
          parametro2="Kurtosis ratio"
          parametro4="Kelly Criterion"
          title="Statistical metrics"
          parametro1Value={rt.skewRatioV}
          parametro2Value={rt.kurtosisRatioV}
          parametro4Value={rt.kellyCriterionV}
        />

        <FourMetrics
          parametro1="Número de trades"
          parametro2="Win %"
          parametro3="Avg Win/Loss"
          parametro4="R expectancy"
          title="Trading metrics"
          parametro1Value={rt.numeroDeTradesV}
          parametro2Value={rt.winV}
          parametro3Value={rt.avgWinLossV}
          parametro4Value={rt.rExpectancyV}
        />
      
      ))
    }
  </div>
  </section>
  <!-- Heatmap Section -->

  <section data-pdf-section class="flow-root">
  <HeatMap trades={trades} initialBalance={backtest.balance} />
  </section>
  <!-- Comparative Charts & Histograms -->
  <section data-pdf-section class="flow-root">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    
        <BarGraph
          title="Rendimiento por día"
          trades={trades}
          initialBalance={backtest.balance}
        />
     
    
    <ReturnDistribution trades={trades} initialBalance={backtest.balance} />
    
    {
      results.map((rt) => (
        <StrVSBench
          Value1={Math.round(Number(rt.alpha) * 100) / 100}
          Value2={Math.round(Number(rt.beta) * 100) / 100}
          Value3={Math.round(Number(rt.omega_ratio) * 100) / 100}
          
        />
        
      ))
    }
  </div>
  </section>
  </div>
  <!-- Recent Activity Log Table -->
  <TradesList tradesPerPage={12} id={idActual} 
  trades={trades} backtest={backtest}
  />

  <!-- System Footer -->
  <footer
    class="border-surface-container-high flex flex-col md:flex-row justify-between items-start gap-8 opacity-60"
  >
    <GlosaryDetail />
  </footer>

</Layout>
