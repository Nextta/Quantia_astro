---
import MiniTVChart from "./DetailsComponentsStr/MiniTVChart.astro";
import type { Activo } from "../enums/activo";
import type { PointInterface } from "../interfaces/pointInterface";

interface Props {
  id?: number;
  ranking?: number;
  titulo?: string;
  tipo: Activo;
  points: PointInterface[];
  returnPercent: number;
  profitFactor:number;
  drawDown:number;
}

const {
  id = 1,
  titulo = "nombre",
  points,
  returnPercent,
  profitFactor,
  drawDown
} = Astro.props as Props;

const formatTwoDecimals = (value: number): string => {
  return value.toFixed(2);
};

// const id = 1;
---

<article
  class="bg-surface-container-high rounded-2xl p-5 sm:p-6 transition-all duration-300 hover:bg-surface-container-highest min-w-0 border-0"
>
<!-- First -->
  <div
    class="
    mb-5 flex 
    flex-col gap-3 
    min-[800px]:flex-row
    min-[800px]:items-start 
    min-[800px]:justify-between"
  >
    <div class="min-w-0 lg:max-w-[65%]">
      <h3
        data-id={id}
        class="text-xl md:text-2xl lg:text-3xl font-bold leading-tight text-on-surface font-headline wrap-break-word"
      >
        {titulo}
      </h3>

      <span
       
        class="inline-block mt-3 text-[11px] px-3 py-1 rounded bg-surface-container-lowest text-on-surface-variant font-semibold uppercase tracking-wide"
      >
        #{id}
      </span>
    </div>

    <div
      class="flex items-center gap-1 text-secondary font-bold text-lg md:text-2xl lg:text-4xl whitespace-nowrap shrink-0 self-start"
    >
      <span
        class="material-symbols-outlined text-lg sm:text-xl"
        style="font-variation-settings: 'FILL' 1;"
      >
        trending_up
      </span>
      {
        <span >
          {returnPercent > 0 ? "+" : ""}
          {formatTwoDecimals(returnPercent)}%<!-- porcentaje -->
        </span>
      }
      
    </div>
  </div>
<!-- First -->
  <div class="bg-surface-container-lowest rounded-xl p-3 sm:p-4 mb-6">
    <div class="rounded-2xl overflow-hidden bg-[#061020]">
      <MiniTVChart points={points} height={110} />
    </div>
  </div>

  <div class="flex flex-col min-[400px]:flex-row gap-3 min-[400px]:items-end min-[400px]:justify-between">
    <div class="grid grid-cols-2 gap-4 sm:gap-6 flex-1 min-w-0 text-left items-end border-0 pr-2">
      <div class="min-w-0">
        <p
          class="text-[10px] uppercase text-on-surface-variant tracking-wide mb-1 leading-tight"
        >
           Profit factor
        </p>
        <p
          class="text-xl sm:text-2xl lg:text-3xl font-bold text-on-surface leading-none"
        >
         {formatTwoDecimals(profitFactor)}
        </p> 
      </div>

      <div class="min-w-0 border-0">
        <p
          class="text-[10px] uppercase text-on-surface-variant tracking-wide mb-1 leading-tight pl-2"
        >
         Drawdown
        </p>
        <p
          class="text-xl sm:text-2xl lg:text-3xl font-bold text-tertiary leading-none pr-6 "
        >
          {formatTwoDecimals(drawDown)}%
        </p>
      </div>
    </div>

    <div class="shrink-0">
      <a
        href={`/strategies/${id}`}
        aria-label="Ver más"
        class="inline-flex h-11 w-11 sm:h-auto sm:w-auto items-center justify-center rounded-full bg-primary px-0 sm:px-3 md:px-4 py-0 sm:py-2 md:py-3 text-on-primary transition-colors hover:bg-primary/80 whitespace-nowrap"
      >
        <span class="hidden lg:inline mr-1">Ver más...</span>
        <span class="material-symbols-outlined shrink-0">arrow_forward</span>
      </a>
    </div>
  </div>
</article>
