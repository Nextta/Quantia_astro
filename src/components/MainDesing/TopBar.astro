---

---

<header
  class="w-full bg-slate-900/60 backdrop-blur-xl shadow-xl shadow-sky-900/10
  flex justify-between items-center pr-4 h-16 w-full gap-10 pl-[15px] border-0 max-[830px]:pl-[10px] h-full border-0"
>
  
  <form
    class="block flex-1 min-w-0 w-full border-0 basis-0 grow-3 max-[530px]:hidden"
    role="search"
  >
    <div class="flex border-0">
      <span
        aria-hidden="true"
        class="material-symbols-outlined text-on-surface-variant text-sm 
        border-2 border-t-[#0D1645]
        border-l-[#0D1645]
        border-b-[#0D1645]
        border-r-[#0D1629]
        shadow-md shadow-[#0D1660]/50
        basis-0 grow-1 items-center justify-center pl-8 pt-1.5 max-[1180px]:pl-1 inline-block rounded-[8px] bg-[#0D1629]"
      >
        search
      </span>
      <label for="global-search" class="sr-only border-0 basis-0 grow-7 items-center justify-center ml-4">
        Buscar estrategias, carteras o activos
      </label>
      <input
        id="global-search"
        name="search"
        type="search"
        class="w-full bg-surface-container-lowest border-none rounded-lg pl-10 pr-4 py-2 text-sm text-on-surface placeholder:text-on-surface-variant/50 focus:ring-1 focus:ring-[#7bd0ff]/40 transition-all font-body border-6 basis-0 grow-10
        items-center justify-center "
        placeholder="Buscar estrategias, carteras o activos..."
        autocomplete="off"
      />
    </div>
  </form>
  <!-- Search - mobile -->
  <svg
    class="min-[530px]:hidden"
    xmlns="http://www.w3.org/2000/svg"
    width="32"
    height="32"
    viewBox="0 0 24 24"
    ><!-- Icon from Material Symbols by Google - https://github.com/google/material-design-icons/blob/master/LICENSE -->
    <path
      fill="#9d8585"
      d="m19.6 21l-6.3-6.3q-.75.6-1.725.95T9.5 16q-2.725 0-4.612-1.888T3 9.5t1.888-4.612T9.5 3t4.613 1.888T16 9.5q0 1.1-.35 2.075T14.7 13.3l6.3 6.3zM9.5 14q1.875 0 3.188-1.312T14 9.5t-1.312-3.187T9.5 5T6.313 6.313T5 9.5t1.313 3.188T9.5 14"
    ></path></svg
  >
  <!-- form-->
  <!-- </div> -->

  <div
    class="border-0 flex flex-row gap-8 basis-0 grow-3 items-center justify-end border-0 border-green-400"
  >
    <span
      class="material-symbols-outlined text-slate-400 cursor-pointer hover:text-sky-400 basis-0 grow-0"
      >notifications</span
    >
    <span
      class="material-symbols-outlined text-slate-400 cursor-pointer hover:text-sky-400 basis-0 grow-0"
      >settings</span
    >
    <img
      alt="User Profile Avatar"
      class="w-8 h-8 rounded-full border border-primary/20"
      data-alt="Professional portrait of a financial analyst in dark studio lighting with blue accents"
      src="https://lh3.googleusercontent.com/aida-public/AB6AXuCoNkzEjBRRR_UwE82X5DH1DQYJaIHBPGT5sTJEK4ZV_aSPAUxNOJyuiUVTiNXRCf9RGXY1jmjbs0vr1JPYkkpDrodGATVLh9t2ImLZ6ATkKJ52GxwgCJOcciRM_mCzNdOQv6JNhGVJOuuEYDe4LaRQgGslqQmQNa7o-VlF8aKoN2xqlMWO4ElDyTEsBqOIe285hrAHk1G9XowOqWIhDfsffZf7TXkzfo01kb_QvHHP5UpdV9LsSZoGbiEmodrjX3aVSz3INNRq7YHZ"
    />
  </div>
</header>
