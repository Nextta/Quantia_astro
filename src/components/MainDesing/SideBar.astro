      >
    </div>
  </div>
  <div
    class="mt-auto px-2 flex w-full
    justify-center border-0"
  >
   
    <button
      class="w-full max-w-[180px] min-w-[40px] bg-secondary text-on-secondary-container py-2 rounded-xl text-xs font-bold uppercase tracking-wider
      max-[700px]:w-[25px] max-[700px]:text-[7px]"
