---
interface Props {
  wid?: boolean;
  hiddenQuantia?: boolean;
}

const { wid = false, hiddenQuantia = false } = Astro.props;
---

<aside
  class:list={[
    "border-0 h-full bg-slate-900 flex flex-col py-6 px-4 gap-2 transition-all max-[700px]:px-1 items-center border-0 border-blue-400 items-start",
    wid ? "w-[55px]" : "w-full",
  ]}
>
  <a href=`/main/Home/`>
    <div class="hidden min-[700px]:flex flex-col mb-8 items-start border-0">
      <span
        class:list={[
          "text-[21px] font-black text-sky-400 font-headline",
          hiddenQuantia ? "hidden" : "block",
        ]}>Quantia</span
      >
      <span
        class:list={[
          "text-[12px] uppercase tracking-widest text-slate-500 font-bold",
          hiddenQuantia ? "hidden" : "block",
        ]}
        class="text-[12px] uppercase tracking-widest text-slate-500 font-bold"
        >Trading</span
      >
    </div>
  </a>
  <div class="flex flex-col gap-1 border-0 border-green-500 w-full">
    <!-- Contenedor de botones -->
    <a href=`/main/Home/`>
      <div
        class:list={[
          "flex items-center gap-3 py-2 text-slate-500",
          "border-0 border-violet-600",
          hiddenQuantia ? "w-full justify-center" : "w-[200px]",
          hiddenQuantia
            ? ""
            : "hover:text-slate-300 hover:bg-slate-800 transition-all rounded-lg cursor-pointer active:translate-x-1 duration-200",
        ]}
      >
        <span class="material-symbols-outlined max-[700px]:ml-2"
          >query_stats</span
        >
        <span
          class:list={[
            " font-manrope text-[17px] font-medium text-[19px] border-0 w-full",
            hiddenQuantia ? "hidden" : "min-[700px]:inline",
          ]}>Dashboard</span
        >
      </div>
    </a>
    <div
      class:list={[
        "flex items-center gap-3 py-2 text-slate-500 ",
        " duration-200 border-0 border-violet-600",
        "max-[700px]:w-full",
        hiddenQuantia
          ? ""
          : "hover:text-slate-300 hover:bg-slate-800 transition-all rounded-lg cursor-pointer active:translate-x-1",
      ]}
    >
      <span class="material-symbols-outlined max-[700px]:ml-2 border-0"
        >dashboard</span
      >
      <span
        class:list={[
          "font-manrope font-medium text-[17px] border-0 w-full",
          hiddenQuantia ? "hidden" : "min-[700px]:inline",
        ]}>Reports</span
      >
    </div>
  </div>
  <div class="mt-auto px-2 flex w-full
    justify-center border-0">
    <a href=`/StrBuilder/StrBuilder/`>
      <button
        class:list={[
          "w-full max-w-[180px] min-w-[40px] bg-secondary text-on-secondary-container py-2 rounded-xl text-xs font-bold uppercase tracking-wider",
          "max-[700px]:w-[25px] max-[700px]:text-[7px]",
          hiddenQuantia ? "hidden" : "block",
        ]}>New Strategy</button
      >
    </a>
  </div>
</aside>
