---
<aside
  class="border-0 h-full
    top-16 h-[calc(100vh-4rem)] w-full bg-slate-900 flex flex-col py-6 px-4 gap-2 transition-all max-[700px]:px-1 items-center border-0 border-red-400"
>
  <a href="/">
    <div class="hidden min-[700px]:flex flex-col mb-8 px-2">
      <span class="text-lg font-black text-sky-400 font-headline">Quantia</span>
      <span
        class="text-[10px] uppercase tracking-widest text-slate-500 font-bold"
        >Trading</span
      >
    </div>
  </a>
  <div class="flex flex-col gap-1 border-0">
    <a href="/">
      <div
        class="flex items-center gap-3 px-3 py-2 text-slate-500 hover:text-slate-300 hover:bg-slate-800 transition-all rounded-lg cursor-pointer active:translate-x-1 duration-200 px-10 "
      >
        <span class="material-symbols-outlined ">query_stats</span>
        <span class="hidden min-[700px]:inline font-manrope text-[15px] font-medium "
          >Dashboard</span
        >
      </div>
    </a>
    <div
      class="flex items-center gap-3 px-3 py-2 text-slate-500 hover:text-slate-300 hover:bg-slate-800 transition-all rounded-lg cursor-pointer active:translate-x-1 duration-200 px-10"
    >
      <span class="material-symbols-outlined">dashboard</span>
      <span class="hidden min-[700px]:inline font-manropefont-medium text-[15px] " 
        >Reports</span
      >
    </div>
  </div>
  <div
    class="mt-auto px-2 flex w-full
    justify-center"
  >
   
    <button
      class="w-full max-w-[180px] min-w-[50px] bg-secondary text-on-secondary-container py-2 rounded-xl text-xs font-bold uppercase tracking-wider
      max-[700px]:w-[70px] max-[700px]:text-[7px]"
      >New Strategy</button
    >
  </div>
</aside>
