<aside
  class="border-0 h-full 
    w-full bg-slate-900 flex flex-col py-6 px-4 gap-2 transition-all max-[700px]:px-1 items-center border-0 border-red-400 
    items-start
    
    "
>
  <a href=`/main/Home/`>
    <div class="hidden min-[700px]:flex flex-col mb-8 items-start border-0">
      <span class="text-[21px] font-black text-sky-400 font-headline">Quantia</span>
      <span
        class="text-[12px] uppercase tracking-widest text-slate-500 font-bold"
        >Trading</span
      >
    </div>
  </a>
  <div class="flex flex-col gap-1 border-0"> <!-- Contenedor de botones -->
    <a href=`/main/Home/`>
      <div
        class="flex items-center gap-3 py-2 text-slate-500 hover:text-slate-300 hover:bg-slate-800 transition-all rounded-lg cursor-pointer active:translate-x-1 duration-200 w-[200px] border-0 border-violet-600
        max-[700px]:w-full
        "
      >
        <span class="material-symbols-outlined max-[700px]:ml-2">query_stats</span>
        <span class="hidden min-[700px]:inline font-manrope text-[17px] font-medium text-[19px] border-0 w-full"
