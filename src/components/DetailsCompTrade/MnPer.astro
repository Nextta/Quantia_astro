---
interface Props {
  totalPNL?: number;
  returnPercent?: number;
}

const { totalPNL = 1429.5, returnPercent = 4.25 } = Astro.props;

const decimalesPNL = totalPNL.toLocaleString("en-US", {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});
---

<div
  class="col-span-12 xl:col-span-5
         bg-surface-container-high rounded-xl
         p-4 sm:p-6
         flex flex-col xl:flex-row
         xl:justify-between xl:items-center
         gap-4 xl:gap-6
         shadow-xl shadow-black/20"
>
  <div class="min-w-0">
    <p
      class="text-on-surface-variant text-[10px] sm:text-xs uppercase font-bold tracking-widest mb-1 whitespace-nowrap"
    >
      Total PnL
    </p>
    <h4
      class="text-xl sm:text-2xl font-headline font-black text-secondary tabular-nums whitespace-nowrap"
    >
      +${decimalesPNL}
    </h4>
  </div>
  <div class="text-left xl:text-right min-w-0">
    <p
      class="text-on-surface-variant text-[10px] sm:text-xs uppercase font-bold tracking-widest mb-1 whitespace-nowrap"
    >
      Return (%)
    </p>
    <h4
      class="text-xl sm:text-2xl font-headline font-black text-secondary tabular-nums whitespace-nowrap"
    >
      +{returnPercent?.toFixed(2)}%
    </h4>
  </div>
</div>
