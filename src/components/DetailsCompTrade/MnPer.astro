---
interface Props {
  totalPNL?: number;
  returnPercent?: number;
  
}

const { totalPNL=1429.50, returnPercent=4.25 } = Astro.props;
---

<div
  class="col-span-4 bg-surface-container-high rounded-xl p-6 flex justify-between items-center gap-6 shadow-xl shadow-black/20"
>
  <div>
    <p
      class="text-on-surface-variant text-xs uppercase font-bold tracking-widest mb-1"
    >
      Total PnL
    </p>
    <h4 class="text-2xl font-headline font-black text-secondary">+${totalPNL.toLocaleString()}</h4>
  </div>
  <div class="text-right">
    <p
      class="text-on-surface-variant text-xs uppercase font-bold tracking-widest mb-1"
    >
      Return (%)
    </p>
    <h4 class="text-2xl font-headline font-black text-secondary">+{returnPercent?.toFixed(2)}%</h4>
  </div>
</div>
