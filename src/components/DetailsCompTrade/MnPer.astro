---
interface Props {
  totalPNL: string;
  returnPercent: string;
}

const { totalPNL, returnPercent} = Astro.props;

// const decimalesPNL = totalPNL.toLocaleString("en-US", {
//   minimumFractionDigits: 2,
//   maximumFractionDigits: 2,
// });

const pnlNumber = Number(totalPNL);
const returnNumber = Number(returnPercent);

const pnlFormatted = Math.abs(pnlNumber).toFixed(2);

const pnlSign =
  pnlNumber < 0
    ? "-"
    : pnlNumber > 0
      ? "+"
      : "";

const pnlColor =
  pnlNumber < 0
    ? "text-red-500"
    : pnlNumber > 0
      ? "text-secondary"
      : "text-gray-400";

const returnColor =
  returnNumber < 0
    ? "text-red-500"
    : returnNumber > 0
      ? "text-secondary"
      : "text-gray-400";
---

<div
  class="col-span-12 xl:col-span-5
         bg-surface-container-high rounded-xl
         p-4 sm:p-6
         flex flex-col xl:flex-row
         xl:justify-between xl:items-center
         gap-4 xl:gap-6
         shadow-xl shadow-black/20"
>
  <div class="min-w-0">
    <p
      class="text-on-surface-variant text-[10px] sm:text-xs uppercase font-bold tracking-widest mb-1 whitespace-nowrap"
    >
      Total PnL
    </p>
    <h4
    class:list={["text-xl sm:text-2xl font-headline font-black tabular-nums whitespace-nowrap", pnlColor]}
    >
      {pnlSign}${pnlFormatted}
    </h4>
  </div>
  <div class="text-left xl:text-right min-w-0">
    <p
      class="text-on-surface-variant text-[10px] sm:text-xs uppercase font-bold tracking-widest mb-1 whitespace-nowrap"
    >
      Return (%)
    </p>
    <h4
    class:list={["text-xl sm:text-2xl font-headline font-black tabular-nums whitespace-nowrap", returnColor]}
    >
      {returnPercent}%
    </h4>
  </div>
</div>
