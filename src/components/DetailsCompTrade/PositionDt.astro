      <span class="text-xs font-bold text-tertiary">-$4.20 (0.12 bps)</span>
    </div>
    <div class="pt-2">
      <div
        class="bg-surface-container-lowest p-3 rounded-lg border border-white/5"
      >
        <p
          class="text-[10px] text-on-surface-variant uppercase font-bold tracking-widest mb-1"
        >
          Exit Reason
        </p>
        <p class="text-xs font-semibold text-primary">Signal: Momentum Fade</p>
      </div>
    </div>
  </div>
</div>
