>
  <div class="flex items-center gap-3 mb-6">
    <span class="material-symbols-outlined text-primary-fixed">payments</span>
    <h5
      class="font-headline font-extrabold uppercase tracking-widest text-xs text-on-surface-variant"
    >
      Position Details
    </h5>
  </div>
  <div class="space-y-5">
    <div class="flex justify-between">
      <span class="text-[10px] text-on-surface-variant uppercase font-bold"
        >Side</span
      >
      <span class="text-xs font-bold text-secondary-fixed">LONG (10x Lev)</span>
    </div>
    <div class="flex justify-between">
      <span class="text-[10px] text-on-surface-variant uppercase font-bold"
        >Size</span
      >
      <span class="text-xs font-bold text-on-surface">1.25 BTC</span>
    </div>
    <div class="flex justify-between">
      <span class="text-[10px] text-on-surface-variant uppercase font-bold"
