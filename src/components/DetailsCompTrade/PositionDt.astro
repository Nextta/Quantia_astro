---
interface Props {
  side?: string;
  size?: string;
  value?: string;
  commissions?: string;
  slippage?: string;
  exitReason?: string;
}

const { side = "LONG (10x Lev)", size = "1.25 BTC", value = "$34,312.50", commissions = "-$14.50", slippage = "-$4.20 (0.12 bps)", exitReason = "Signal: Momentum Fade" } = Astro.props;

---

<div
  class="col-span-1 bg-surface-container-high rounded-xl p-6 shadow-lg border border-white/5"
>
  <div class="flex items-center gap-3 mb-6">
    <span class="material-symbols-outlined text-primary-fixed">payments</span>
    <h5
      class="font-headline font-extrabold uppercase tracking-widest text-xs text-on-surface-variant"
    >
      Position Details
    </h5>
  </div>
  <div class="space-y-5">
    <div class="flex justify-between">
      <span class="text-[10px] text-on-surface-variant uppercase font-bold"
        >Side</span
      >
      <span class="text-xs font-bold text-secondary-fixed">{side}</span>
    </div>
    <div class="flex justify-between">
      <span class="text-[10px] text-on-surface-variant uppercase font-bold"
        >Size</span
      >
      <span class="text-xs font-bold text-on-surface">{size}</span>
    </div>
    <div class="flex justify-between">
      <span class="text-[10px] text-on-surface-variant uppercase font-bold"
        >Value</span
      >
      <span class="text-xs font-bold text-on-surface">{value}</span>
    </div>
    <div class="flex justify-between">
      <span class="text-[10px] text-on-surface-variant uppercase font-bold"
        >Commissions</span
      >
      <span class="text-xs font-bold text-tertiary">{commissions}</span>
    </div>
    <div class="flex justify-between">
      <span class="text-[10px] text-on-surface-variant uppercase font-bold"
        >Slippage</span
      >
      <span class="text-xs font-bold text-tertiary">{slippage}</span>
    </div>
    <div class="pt-2">
      <div
        class="bg-surface-container-lowest p-3 rounded-lg border border-white/5"
      >
        <p
          class="text-[10px] text-on-surface-variant uppercase font-bold tracking-widest mb-1"
        >
          Exit Reason
        </p>
        <p class="text-xs font-semibold text-primary">{exitReason}</p>
      </div>
    </div>
  </div>
</div>
