---
interface Props {
  side?: string;
  size?: string;
  value?: string;
  commissions?: string;
  slippage?: string;
  exitReason?: string;
}

const {
  side = "LONG (10x Lev)",
  size = "1.25 BTC",
  value = "$34,312.50",
  commissions = "-$14.50",
  slippage = "-$4.20 (0.12 bps)",
  exitReason = "Signal: Momentum Fade",
} = Astro.props;
---

<div
  class="col-span-1 bg-surface-container-high rounded-xl
         p-4 min-[470px]:p-6
         shadow-lg border border-white/5"
>
  <!-- Header -->
  <div
    class="flex flex-col items-center gap-2 mb-6
           min-[470px]:flex-row min-[470px]:gap-3"
  >
    <span class="material-symbols-outlined text-primary-fixed">payments</span>
    <h5
      class="font-headline font-extrabold uppercase
             text-[11px] min-[470px]:text-xs
             tracking-wider min-[470px]:tracking-widest
             text-on-surface-variant
             text-center min-[470px]:text-left"
    >
      Position Details
    </h5>
  </div>

  <div class="space-y-5">
    
    <div
      class="flex flex-col items-center gap-1
             min-[470px]:flex-row min-[470px]:justify-between min-[470px]:gap-3"
    >
      <span class="text-[10px] text-on-surface-variant uppercase font-bold">
        Side
      </span>
      <span class="text-xs font-bold text-secondary-fixed">{side}</span>
    </div>

    
    <div
      class="flex flex-col items-center gap-1
             min-[470px]:flex-row min-[470px]:justify-between min-[470px]:gap-3"
    >
      <span class="text-[10px] text-on-surface-variant uppercase font-bold">
        Size
      </span>
      <span class="text-xs font-bold text-on-surface">{size}</span>
    </div>

   
    <div
      class="flex flex-col items-center gap-1
             min-[470px]:flex-row min-[470px]:justify-between min-[470px]:gap-3"
    >
      <span class="text-[10px] text-on-surface-variant uppercase font-bold">
        Value
      </span>
      <span class="text-xs font-bold text-on-surface">{value}</span>
    </div>

    
    <div
      class="flex flex-col items-center gap-1
             min-[470px]:flex-row min-[470px]:justify-between min-[470px]:gap-3"
    >
      <span class="text-[10px] text-on-surface-variant uppercase font-bold">
        Commissions
      </span>
      <span class="text-xs font-bold text-tertiary">{commissions}</span>
    </div>

    
    <div
      class="flex flex-col items-center gap-1
             min-[470px]:flex-row min-[470px]:justify-between min-[470px]:gap-3"
    >
      <span class="text-[10px] text-on-surface-variant uppercase font-bold">
        Slippage
      </span>
      <span
        class="text-xs font-bold text-tertiary text-center min-[470px]:text-right"
      >
        {slippage}
      </span>
    </div>

    
    <div class="pt-2">
      <div
        class="bg-surface-container-lowest p-3 rounded-lg border border-white/5
               text-center min-[470px]:text-left"
      >
        <p
          class="text-[10px] text-on-surface-variant uppercase font-bold tracking-widest mb-1"
        >
          Exit Reason
        </p>
        <p class="text-xs font-semibold text-primary">{exitReason}</p>
      </div>
    </div>
  </div>
</div>
