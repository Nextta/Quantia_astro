---
interface Props {
  title?: string;
}

const { title = "Backtest Fidelity" } = Astro.props;

---

<div
  class="bg-primary/5 rounded-xl
         p-4 min-[470px]:p-6
         border border-primary/10
         flex flex-col items-center gap-3
         min-[470px]:flex-row min-[470px]:justify-between"
>
  <div class="flex flex-col items-center gap-2
           min-[470px]:flex-row min-[470px]:items-center min-[470px]:gap-4">
    <div
      class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center"
    >
      <span class="material-symbols-outlined text-primary">verified</span>
    </div>
    <div class="text-center min-[470px]:text-left">
      <h6 class="font-headline font-bold text-white">{title}</h6>
      <p class="text-xs text-on-surface-variant">
        Order Book Depth Simulation Active
      </p>
    </div>
  </div>
  <span class="text-xs font-black text-primary">98% Accuracy</span>
</div>
