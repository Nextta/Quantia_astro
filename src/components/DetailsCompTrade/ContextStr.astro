---
interface Props {
  title?: string;

}

const { title = "Strategy Context" } = Astro.props;
---

<div
  class="col-span-12 lg:col-span-7 bg-surface-container-high rounded-xl p-6 border border-white/5"
>
  <div class="flex items-center justify-between mb-4">
    <h5 class="font-headline font-extrabold text-white">{title}</h5>
    <button class="text-xs text-primary font-bold hover:underline"
      >View Journal</button
    >
  </div>
  <p class="text-on-surface-variant text-sm leading-relaxed italic">
    "The entry was triggered by a 15-minute bullish engulfing candle coupled
    with an RSI breakout above 55. High volume confirm on Binance Spot data.
    Price held above VWAP throughout the duration. Exit triggered by MACD
    bearish crossover on the 5-minute timeframe. Manual intervention: None."
  </p>
  <div class="flex gap-2 mt-4">
    <span
      class="px-3 py-1 bg-surface-container-lowest text-xs font-bold rounded-full text-on-surface-variant"
      >#HighVolume</span
    >
    <span
      class="px-3 py-1 bg-surface-container-lowest text-xs font-bold rounded-full text-on-surface-variant"
      >#BullishEngulfing</span
    >
    <span
      class="px-3 py-1 bg-surface-container-lowest text-xs font-bold rounded-full text-on-surface-variant"
      >#Scalp</span
    >
  </div>
</div>
