---

interface Props {
  title?: string;
  valueMFE?: number;
  valueMFEPercent?: number;
  valueMAE?: number;
  valueMAEPercent?: number;
  barFill?: number; // Percentage value bar (0-100)

}

const { title = "Trade Excursion", valueMFE = 1580, valueMFEPercent = 4.8, valueMAE = -120, valueMAEPercent = -0.3, barFill = 79 } = Astro.props;
---
<div
  class="col-span-1 bg-surface-container-high rounded-xl p-6 shadow-lg border border-white/5"
>
  <div class="flex items-center gap-3 mb-6">
    <span class="material-symbols-outlined text-secondary">trending_up</span>
    <h5
      class="font-headline font-extrabold uppercase tracking-widest text-xs text-on-surface-variant"
    >
      {title}
    </h5>
  </div>
  <div class="space-y-6">
    <div>
      <p
        class="text-[10px] text-on-surface-variant uppercase font-bold tracking-widest mb-1"
      >
        Max Favorable (MFE)
      </p>
      <div class="flex items-baseline gap-2">
        <span class="text-lg font-black text-secondary">+${valueMFE.toLocaleString()}</span>
        <span class="text-xs text-secondary/60">+{valueMFEPercent?.toFixed(1)}%</span>
      </div>
    </div>
    <div>
      <p
        class="text-[10px] text-on-surface-variant uppercase font-bold tracking-widest mb-1"
      >
        Max Adverse (MAE)
      </p>
      <div class="flex items-baseline gap-2">
        <span class="text-lg font-black text-tertiary">-${valueMAE.toLocaleString()}</span>
        <span class="text-xs text-tertiary/60">{valueMAEPercent?.toFixed(1)}%</span>
      </div>
    </div>
    <div class="pt-4 border-t border-white/5">
      <p
        class="text-[10px] text-on-surface-variant uppercase font-bold tracking-widest mb-1"
      >
        Trade Efficiency
      </p>
      <div class="w-full bg-surface-container-low h-1.5 rounded-full mt-2">
        <div class="bg-secondary h-full rounded-full" style={`width: ${barFill}%`}></div>
      </div>
      <p class="text-right text-[10px] font-bold text-secondary mt-1">{barFill.toFixed(1)}%</p>
    </div>
  </div>
</div>
