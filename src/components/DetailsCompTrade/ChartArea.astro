---
import { dataFrame } from "../../datos/dataFrame";
import type {
  LineData,
  UTCTimestamp,
  CandlestickData,
} from "lightweight-charts";

type EmaPoint = LineData<UTCTimestamp>;
// type Ema200Point = LineData<UTCTimestamp>;
type CandlePoint = CandlestickData<UTCTimestamp>;

type EmaConfig = {
  name: string;
  color: string;
  data: EmaPoint[];
}

type EmaInput = EmaConfig | EmaConfig[];

interface Props {
  candles?: CandlePoint[];
  markers?: {
    time: { year: number; month: number; day: number };
    position: string;
    color: string;
    shape: string;
    text: string;
  }[];
  height?: number;
  upColor?: string;
  downColor?: string;
  
  dataEMABefore?: EmaInput;
  // dataEMA200Before: Ema200Point[];
}



const {
  candles = [],
  markers = [],
  // dataEMA200Before,
  dataEMABefore,
  height = 450,
  upColor = "#26a69a",
  downColor = "#ef5350",
} = Astro.props as Props;

console.log(dataEMABefore);

//Para la ema--------:

const dataEmaFromDF: Ema50Point[] = dataFrame.map((dt) => ({
  time: Math.floor(dt.timestamp / 1000) as UTCTimestamp,
  value: dt.ema_50,
}));

const dataEma =
  dataEMABefore && dataEMABefore.length > 0 ? dataEMABefore : dataEmaFromDF;

  //Ema 200

// const dataEma200FromDF: Ema200Point[] = dataFrame.map((dt) => ({
//   time: Math.floor(dt.timestamp / 1000) as UTCTimestamp,
//   value: dt.ema_200,
// }))

// const dataEma200 = 
  // dataEMA200Before && dataEMA200Before.length > 0  ? dataEMA200Before : dataEma200FromDF;

//Velas

const toChartTime = (timestamp: number): UTCTimestamp => {
  return (
    timestamp > 9999999999 ? Math.floor(timestamp / 1000) : timestamp
  ) as UTCTimestamp;
};

const candlesFromDF: CandlePoint[] = dataFrame.map((dt) => ({
  time: toChartTime(dt.timestamp),
  open: dt.open,
  high: dt.high,
  low: dt.low,
  close: dt.close,
}));

console.log(candlesFromDF);

// const chartCandles = candles && candles.length > 0 ? candles : candlesFromDF;
const chartCandles = candlesFromDF;

---

<section
  class="bg-surface-container-low rounded-xl overflow-hidden border-t border-white/5 shadow-2xl"
>
  <div
    id="trade-chart"
    class="w-full"
    style={`height: ${height}px`}
    data-candles={JSON.stringify(chartCandles)}
    
    data-markers={JSON.stringify(markers)}
    
    data-ema={JSON.stringify(dataEma)}
    data-up-color={upColor}
    data-down-color={downColor}
  >
  </div>
</section>

<script>
  import {
    createChart,
    CandlestickSeries,
    LineSeries,
    createSeriesMarkers,
    ColorType,
    type UTCTimestamp,
    type LineData,
    type CandlestickData,
  } from "lightweight-charts";
  type ChartTime = {
    year: number;
    month: number;
    day: number;
  };

  type Candle = CandlestickData<UTCTimestamp>;


  type Ema50Point = LineData<UTCTimestamp>;
  type Ema200Point = LineData<UTCTimestamp>;

  const container = document.getElementById("trade-chart");
  if (container) {
    // Leer los datos del data-
    // const candles = JSON.parse(container.dataset.candles || "[]") as Candle[];
    const markers = JSON.parse(container.dataset.markers || "[]");
    const rawEma = JSON.parse(container.dataset.ema || "[]") as Ema50Point[];
    // const rawEma200 = JSON.parse(container.dataset.ema200 || "[]") as Ema200Point[];

    //Candles ----
    // type Candle = CandlestickData<UTCTimestamp>;

    const candles = JSON.parse(container.dataset.candles || "[]") as Candle[];

    //Candles

    const upColor = container.dataset.upColor || "#26a69a";
    const downColor = container.dataset.downColor || "#ef5350";

    const chart = createChart(container, {
      layout: {
        textColor: "#c6c6cd",
        background: { type: ColorType.Solid, color: "#0b1326" },
      },
      grid: {
        vertLines: { color: "rgba(34, 42, 61, 0.4)" },
        horzLines: { color: "rgba(34, 42, 61, 0.4)" },
      },
      rightPriceScale: { borderColor: "rgba(34, 42, 61, 0.8)" },
      timeScale: { borderColor: "rgba(34, 42, 61, 0.8)" },
      width: container.clientWidth,
      height: container.clientHeight,
    });

    const series = chart.addSeries(CandlestickSeries, {
      upColor,
      downColor,
      borderVisible: true,
      wickUpColor: upColor,
      wickDownColor: downColor,
    });

    series.setData(candles);



    console.log(rawEma);
    // console.log(rawEma200);

    if (rawEma.length > 0) {
      const emaSeries = chart.addSeries(LineSeries, {
        color: "#facc15",
        lineWidth: 2,
      });
      emaSeries.setData(rawEma);
    }
    // if (rawEma200.length > 0) {
    //   const emaSeries = chart.addSeries(LineSeries, {
    //     color: "#ff0000",
    //     lineWidth: 2,
    //   });
    //   emaSeries.setData(rawEma200);
    // }

    if (markers.length > 0) {
      createSeriesMarkers(series, markers);
    }

    chart.timeScale().fitContent();

    // Responsive
    const resizeObserver = new ResizeObserver((entries) => {
      if (entries.length === 0 || entries[0].target !== container) return;
      const { width, height } = entries[0].contentRect;
      chart.applyOptions({ width, height });
    });
    resizeObserver.observe(container);
  }
</script>
