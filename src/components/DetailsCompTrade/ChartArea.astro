---
//Las props se colocarán una vez incorpore el gráfico de Tradingview


---


<section
  class="bg-surface-container-low rounded-xl overflow-hidden border-t border-white/5 shadow-2xl"
>
  <div class="h-[450px] relative">
    <!-- Fake Chart Rendering via background image and absolute positioning -->
    <div
      class="absolute inset-0 opacity-80"
      style="background-image: linear-gradient(#131b2e 1px, transparent 1px), linear-gradient(90deg, #131b2e 1px, transparent 1px); background-size: 40px 40px;"
    >
    </div>
    <!-- Decorative Chart Line / Bars (Representative) -->
    <div class="absolute inset-0 flex items-end justify-center p-12 gap-2">
      <!-- Candles simulation -->
      <div class="w-3 h-24 bg-tertiary/60 rounded-sm"></div>
      <div class="w-3 h-32 bg-secondary/60 rounded-sm"></div>
      <div class="w-3 h-40 bg-secondary/60 rounded-sm"></div>
      <div class="w-3 h-20 bg-tertiary/60 rounded-sm"></div>
      <div class="w-3 h-36 bg-secondary/60 rounded-sm relative">
        <!-- ENTRY MARKER -->
        <div
          class="absolute -top-16 left-1/2 -translate-x-1/2 flex flex-col items-center"
        >
          <div
            class="bg-secondary text-on-secondary px-2 py-1 rounded text-[10px] font-black whitespace-nowrap mb-1"
          >
            ENTRY @ 27,450.00
          </div>
          <span
            class="material-symbols-outlined text-secondary text-3xl"
            style="font-variation-settings: 'FILL' 1;">arrow_drop_up</span
          >
        </div>
      </div>
      <div class="w-3 h-48 bg-secondary/60 rounded-sm"></div>
      <div class="w-3 h-56 bg-secondary/60 rounded-sm"></div>
      <div class="w-3 h-64 bg-secondary/60 rounded-sm"></div>
      <div class="w-3 h-52 bg-secondary/60 rounded-sm"></div>
      <div class="w-3 h-72 bg-secondary/60 rounded-sm relative">
        <!-- EXIT MARKER -->
        <div
          class="absolute -top-16 left-1/2 -translate-x-1/2 flex flex-col items-center"
        >
          <div
            class="bg-error text-on-error px-2 py-1 rounded text-[10px] font-black whitespace-nowrap mb-1"
          >
            EXIT @ 28,620.50
          </div>
          <span
            class="material-symbols-outlined text-error text-3xl"
            style="font-variation-settings: 'FILL' 1;">close</span
          >
        </div>
      </div>
      <div class="w-3 h-60 bg-tertiary/60 rounded-sm"></div>
      <div class="w-3 h-44 bg-tertiary/60 rounded-sm"></div>
    </div>
    <!-- Chart Overlay Details -->
    <div
      class="absolute top-6 left-6 flex items-center gap-4 bg-surface-container-highest/80 backdrop-blur-md px-4 py-2 rounded-lg text-xs font-headline font-bold text-on-surface"
    >
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-secondary"></span>
        <span>MA(20): 27,840.10</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-primary"></span>
        <span>MA(50): 27,120.45</span>
      </div>
    </div>
    <div class="absolute top-6 right-6 flex items-center gap-3">
      <button
        class="bg-surface-container-highest p-2 rounded-lg hover:bg-surface-bright transition-colors"
      >
        <span class="material-symbols-outlined text-on-surface-variant"
          >zoom_in</span
        >
      </button>
      <button
        class="bg-surface-container-highest p-2 rounded-lg hover:bg-surface-bright transition-colors"
      >
        <span class="material-symbols-outlined text-on-surface-variant"
          >photo_camera</span
        >
      </button>
    </div>
  </div>
</section>
