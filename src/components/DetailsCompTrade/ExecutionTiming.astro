---
interface Props {
  title?: string;
  entryTimestamp?: string;
  exitTimestamp?: string;
  entryPrice?: number;
  exitPrice?: number;
  tradeDuration?: string;
}

const { title = "Execution Timing", entryTimestamp = "2023-10-14 08:30:00", exitTimestamp = "2023-10-14 14:45:12", entryPrice = 27450.00, exitPrice = 28620.50, tradeDuration = "6h 15m 12s" } = Astro.props;

---

<div
  class="col-span-2 bg-surface-container-high rounded-xl p-6 shadow-lg border border-white/5"
>
  <div class="flex items-center gap-3 mb-6">
    <span class="material-symbols-outlined text-primary">schedule</span>
    <h5
      class="font-headline font-extrabold uppercase tracking-widest text-xs text-on-surface-variant"
    >
      {title}
    </h5>
  </div>
  <div class="grid grid-cols-2 gap-y-6">
    <div>
      <p
        class="text-[10px] text-on-surface-variant uppercase font-bold tracking-widest mb-1"
      >
        Entry Timestamp
      </p>
      <p class="text-sm font-semibold text-on-surface">{entryTimestamp}</p>
    </div>
    <div>
      <p
        class="text-[10px] text-on-surface-variant uppercase font-bold tracking-widest mb-1"
      >
        Exit Timestamp
      </p>
      <p class="text-sm font-semibold text-on-surface">{exitTimestamp}</p>
    </div>
    <div>
      <p
        class="text-[10px] text-on-surface-variant uppercase font-bold tracking-widest mb-1"
      >
        Entry Price
      </p>
      <p class="text-sm font-bold text-on-surface">${entryPrice.toLocaleString()}</p>
    </div>
    <div>
      <p
        class="text-[10px] text-on-surface-variant uppercase font-bold tracking-widest mb-1"
      >
        Exit Price
      </p>
      <p class="text-sm font-bold text-on-surface">${exitPrice.toLocaleString()}</p>
    </div>
    <div
      class="col-span-2 p-3 bg-surface-container-low rounded-lg flex items-center justify-between"
    >
      <span
        class="text-[10px] text-on-surface-variant uppercase font-black tracking-tighter"
        >Trade Duration</span
      >
      <span class="text-primary font-bold">{tradeDuration}</span>
    </div>
  </div>
</div>
