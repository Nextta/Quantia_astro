---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Glosario de Conceptos",
  subtitle = "Definiciones clave del reporte y la operativa",
} = Astro.props as Props;

const items = [
  {
    term: "Overall Returns",
    definition:
      "Retornos generales. Sección que agrupa las principales métricas de rendimiento, riesgo y comportamiento de una estrategia de trading.",
  },
  {
    term: "Total Return",
    definition:
      "Retorno total. Representa la ganancia o pérdida acumulada de la estrategia durante todo el periodo analizado. Puede expresarse en dinero o porcentaje.",
  },
  {
    term: "Best Month",
    definition:
      "Mejor mes. Indica la mayor ganancia obtenida por la estrategia durante un solo mes.",
  },
  {
    term: "Worst Month",
    definition:
      "Peor mes. Indica la mayor pérdida registrada por la estrategia durante un solo mes.",
  },
  {
    term: "Market Time",
    definition:
      "Tiempo en mercado. Porcentaje del periodo total durante el cual la estrategia mantuvo una o más operaciones abiertas.",
  },
  {
    term: "Max Drawdown",
    definition:
      "Máxima caída de capital. Representa la mayor disminución sufrida desde un máximo de la curva de balance o equity hasta el mínimo posterior.",
  },
  {
    term: "Ulcer Index",
    definition:
      "Índice de ulceración. Mide la profundidad y la duración de los drawdowns. Un valor más bajo indica una curva de capital más estable.",
  },
  {
    term: "Risk of Ruin",
    definition:
      "Riesgo de ruina. Probabilidad estimada de que la estrategia pierda una parte crítica del capital o alcance el límite establecido como ruina.",
  },
  {
    term: "Annual Volatility",
    definition:
      "Volatilidad anual. Mide cuánto varían los retornos de la estrategia durante un año. Una volatilidad alta indica movimientos más agresivos e irregulares.",
  },
  {
    term: "Skew Ratio",
    definition:
      "Ratio de asimetría. Mide si la distribución de retornos presenta resultados extremos principalmente hacia las ganancias o hacia las pérdidas.",
  },
  {
    term: "Kurtosis Ratio",
    definition:
      "Ratio de curtosis. Mide la frecuencia con la que aparecen resultados extremos en la distribución de retornos de la estrategia.",
  },
  {
    term: "Kelly Criterion",
    definition:
      "Criterio de Kelly. Estima la fracción óptima del capital que debería arriesgarse para maximizar el crecimiento compuesto a largo plazo.",
  },
  {
    term: "Number of Trades",
    definition:
      "Número de operaciones. Cantidad total de trades ejecutados por la estrategia durante el periodo del backtesting.",
  },
  {
    term: "Win %",
    definition:
      "Porcentaje de operaciones ganadoras. Indica qué proporción de todos los trades terminó con un resultado positivo.",
  },
  {
    term: "Avg Win/Loss",
    definition:
      "Relación entre ganancia y pérdida promedio. Compara cuánto gana en promedio una operación ganadora contra cuánto pierde una operación perdedora.",
  },
  {
    term: "R Expectancy",
    definition:
      "Expectativa en múltiplos de R. Indica cuánto se espera ganar o perder en promedio por operación en relación con el riesgo inicial asumido.",
  },
];
---

<div class="bg-surface-container-high rounded-xl overflow-hidden w-full" data-html2canvas-ignore>
  <div
    class="px-6 py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-2"
  >
    <h3 class="text-lg font-bold font-headline text-on-surface">
      {title}
    </h3>

    <span class="text-xs text-on-surface-variant">
      {subtitle}
    </span>
  </div>

  <div class="bg-surface-container-low px-6 py-2">
    <div class="divide-y divide-surface-container">
      {
        items.map((item) => (
          <div class="py-5 grid grid-cols-1 md:grid-cols-[240px_minmax(0,1fr)] gap-3 md:gap-6">
            <div>
              <h4 class="text-sm font-bold text-primary uppercase tracking-wide">
                {item.term}
              </h4>
            </div>

            <div>
              <p class="text-md leading-7 text-white">
                {item.definition}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>
