---
const items = [
  {
    term: "Concepto 1",
    definition:
      "Definición------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------",
  },
];
---

<div class="bg-surface-container-high rounded-xl overflow-hidden mb-8">
  <div class="px-6 py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-2">
    <h3 class="text-lg font-bold font-headline text-on-surface">
      Glosario de Conceptos
    </h3>

    <span class="text-xs text-on-surface-variant">
      Definiciones clave del reporte y la operativa
    </span>
  </div>

  <div class="bg-surface-container-low px-6 py-2">
    <div class="divide-y divide-surface-container">
      {items.map((item) => (
        <div class="py-5 grid grid-cols-1 md:grid-cols-[240px_minmax(0,1fr)] gap-3 md:gap-6">
          <div>
            <h4 class="text-sm font-bold text-primary uppercase tracking-wide">
              {item.term}
            </h4>
          </div>

          <div>
            <p class="text-sm leading-7 text-on-surface-variant">
              {item.definition}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>