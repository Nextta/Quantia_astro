---
interface Props {
  title?: string;
  ratioValue1?: number;
  ratioValue2?: number;
}

const {
  title = "Ratio de Sharpe",
  ratioValue1 = -5,
  ratioValue2 = 5,
} = Astro.props as Props;
---

<div class="bg-surface-container-low rounded-xl p-6 h-80 flex flex-col">
  <h4 class="text-sm font-bold mb-6">{title}</h4>
  <div class="flex-1 flex items-end gap-1">
    <div class="flex-1 bg-tertiary/40 h-[10%] rounded-t-sm"></div>
    <div class="flex-1 bg-tertiary/60 h-[25%] rounded-t-sm"></div>
    <div class="flex-1 bg-tertiary h-[45%] rounded-t-sm"></div>
    <div class="flex-1 bg-surface-container-highest h-[85%] rounded-t-sm"></div>
    <div class="flex-1 bg-secondary h-[65%] rounded-t-sm"></div>
    <div class="flex-1 bg-secondary/60 h-[30%] rounded-t-sm"></div>
    <div class="flex-1 bg-secondary/40 h-[15%] rounded-t-sm"></div>
  </div>
  <div
    class="flex justify-between text-[10px] text-on-surface-variant mt-4 font-bold"
  >
    <span>{ratioValue1}%</span><span>0%</span><span>{ratioValue2}%</span>
  </div>
</div>
