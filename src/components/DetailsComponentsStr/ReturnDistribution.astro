---
import type { Trade } from "../../interfaces/trades";
import {calculateMonthlyPerformance,
  calculateAverageMonthlyPerformance,} from "../../utils/functionsGeneral";

  
interface Props {
  title?: string;
  trades: Trade[];
  initialBalance: number;
  ratioValue1?: number;
  ratioValue2?: number;
}

const {
  title = "Rendimiento mensual",
  trades,
  initialBalance,
  ratioValue1 = -1,
  ratioValue2 = 1,
} = Astro.props as Props;

const monthNames = [
  "Ene",
  "Feb",
  "Mar",
  "Abr",
  "May",
  "Jun",
  "Jul",
  "Ago",
  "Sep",
  "Oct",
  "Nov",
  "Dic",
];



const yearRows = calculateMonthlyPerformance(
  trades,
  initialBalance,
);

const monthlyAverages =
  calculateAverageMonthlyPerformance(yearRows);

const monthlyAveragesNames = monthlyAverages.map((result) => ({
  month: result.month,
  name:
    monthNames[result.month - 1] ??
    `Mes ${result.month}`,
  average:
    result.average,
  observations: result.observations,
}));

// Escala vertical de la gráfica.
// Incluye los límites enviados por props y los valores reales.
const maxAbsoluteAverage = Math.max(
  1,
  Math.abs(ratioValue1),
  Math.abs(ratioValue2),
  ...monthlyAveragesNames.map((result) =>
    Math.abs(result.average ?? 0)
  ),
);


---


<div
  class="bg-surface-container-low rounded-xl p-6 h-80 flex flex-col"
>
  <h4 class="text-sm font-bold mb-4">{title}</h4>

  <div class="relative flex-1">
    <!-- Línea cero -->
    <div
      class="absolute left-0 right-0 top-1/2 border-t
             border-on-surface-variant/40"
    ></div>

    <div class="grid grid-cols-12 gap-1 h-full">
      {
        monthlyAveragesNames.map((avg) => {
          const value = avg.average ?? 0;
            
          const height = Math.min(
            (Math.abs(value) / maxAbsoluteAverage) * 100,
            100,
          );

          return (
            <div class="grid grid-rows-2 h-full min-w-0 group relative">
              <!-- Positivos -->
              <div class="flex items-end">
                {value > 0 && (
                  <div
                    class="w-full bg-secondary rounded-t-sm"
                    style={`height: ${height}%`}
                  ></div>
                )}
              </div>

              <!-- Negativos -->
              <div class="flex items-start">
                {value < 0 && (
                  <div
                    class="w-full bg-tertiary rounded-b-sm"
                    style={`height: ${height}%`}
                  ></div>
                )}
              </div>

              <!-- Tooltip -->
              <div
                class="hidden group-hover:block absolute z-10 bottom-full
                       left-1/2 -translate-x-1/2 mb-2 whitespace-nowrap
                       rounded bg-surface-container-highest px-2 py-1 text-xs"
              >
                <div>
                  {avg.name}: {avg.average?.toFixed(2) ?? "Sin datos"}%
                </div>

                <div>
                  {avg.observations} observaciones
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>

  <div
    class="grid grid-cols-12 gap-1 mt-3 text-[10px]
           text-on-surface-variant text-center font-bold"
  >
    {
      monthlyAveragesNames.map((avg) => (
        <span>{avg.name}</span>
      ))
    }
  </div>
  <div
    id="monthly-debug-data"
    data-trades={JSON.stringify(trades)}
    data-initial-balance={10000}
    hidden
  >
  </div>
</div>


