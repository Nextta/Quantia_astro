---
import { getResults } from "../../utils/functionsGeneral";

interface Props {
  id: number;
  title?: string;
}

const { title = "Rendimiento por Día", id = Astro.params } = Astro.props as Props;


const idActual = Number(id);
const results = await getResults(idActual);
const activo = true;

---

<div class="bg-surface-container-low rounded-xl p-6 h-80 flex flex-col">
  <h4 class="text-sm font-bold mb-6">{title}</h4>
  <div class="flex-1 flex items-end gap-2 px-2">
    {
  results.map((rt) => (
    <div
      class="flex-1 bg-surface-container-highest rounded-t-sm relative group"
      style={`height: ${Math.min(Math.abs(100), 100)}%`}
    ></div>

    
    
    <div
      class="flex-1 bg-secondary rounded-t-sm relative group"
      style={`height: ${Math.min(Math.abs(rt.z_score), 100)}%`}
    ></div>




    <div
      class="flex-1 bg-secondary rounded-t-sm relative group"
      style={`height: ${Math.min(Math.abs(75), 100)}%`}
    ></div>
 
    


    <div
      class="flex-1 bg-tertiary rounded-t-sm relative group"
      style={`height: ${Math.min(Math.abs(75), 100)}%`}
    ></div>

    <div
      class="flex-1 bg-tertiary rounded-t-sm relative group"
      style={`height: ${Math.min(Math.abs(75), 100)}%`}
    ></div>
      ))
}

    
  </div>
  <div
    class="flex justify-between text-[10px] text-on-surface-variant mt-4 font-bold uppercase tracking-widest"
  >
    <span>Lun</span><span>Mar</span><span>Mie</span><span>Jue</span><span
      >Vie</span
    >
  </div>
</div>
