---
import { getDayAverage } from "../../utils/functionsGeneral";
import type { WeekAverage } from "../../utils/functionsGeneral";
import type { Trade } from "../../interfaces/trades";

interface Props {
  id: number;
  title?: string;
  trade: Trade[];
  initialBalance: number;
}

const {
  title = "Rendimiento por día",
  trade,
  initialBalance,
} = Astro.props as Props;

const getDays = getDayAverage(trade, initialBalance);

function getCellClass(value: number | null): string {
  const base =
    "w-full rounded-t-sm relative group transition-all duration-300";

  if (value === null || value === 0) {
    return `${base} bg-gray-500`;
  }

  if (value < 0) {
    return `${base} bg-red-500`;
  }

  return `${base} bg-green-500`;
}

function getMax(weekAverages: WeekAverage[]): number {
  let actualMax = 0;

  for (const item of weekAverages) {
    const currentAverage = Math.abs(item.average ?? 0);

    if (currentAverage > actualMax) {
      actualMax = currentAverage;
    }
  }

  return actualMax;
}

const maxAverage = getMax(getDays);

const dayLabels = ["LUN", "MAR", "MIE", "JUE", "VIE"];

const chartDays = getDays.map((item) => {
  const absoluteAverage = Math.abs(item.average ?? 0);

  const height =
    maxAverage > 0
      ? (absoluteAverage / maxAverage) * 100
      : 0;

  return {
    ...item,
    height,
    label: dayLabels[item.day - 1],
  };
});
---

<div class="bg-surface-container-low rounded-xl p-6 h-80 flex flex-col">
  <h4 class="text-sm font-bold mb-6">
    {title}
  </h4>

  <div class="flex-1 flex items-end gap-2 px-2">
  {
    chartDays.map((item) => (
      <div class="flex-1 h-full flex items-end relative group">
        <div
          class={getCellClass(item.average)}
          style={`height: ${item.height}%; min-height: 4px;`}
        >
          <div
            class="
              absolute
              left-1/2
              bottom-full
              -translate-x-1/2
              mb-2
              z-20
              whitespace-nowrap
              rounded-md
              bg-surface-container-highest
              px-3
              py-2
              text-xs
              text-on-surface
              shadow-lg
              opacity-0
              pointer-events-none
              transition-opacity
              duration-200
              group-hover:opacity-100
            "
          >
            {
              item.average === null ? (
                <>
                  <div class="font-bold">{item.label}: sin datos</div>
                  <div>{item.observations} observaciones</div>
                </>
              ) : (
                <>
                  <div class="font-bold">
                    {item.label}: {item.average.toFixed(2)}%
                  </div>

                  <div>
                    {item.observations} observaciones
                  </div>
                </>
              )
            }
          </div>
        </div>
      </div>
    ))
  }
</div>

  <div
    class="grid grid-cols-5 gap-2 px-2 text-[10px] text-on-surface-variant mt-4 font-bold uppercase tracking-widest text-center"
  >
    {
      chartDays.map((item) => (
        <span>{item.label}</span>
      ))
    }
  </div>
</div>

