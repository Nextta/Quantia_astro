---
import { getDayAverage, createChartDays } from "../../utils/functionsGeneral";
import type { Trade } from "../../interfaces/trades";
import type { WeekAverage } from "../../utils/functionsGeneral";
// import { buildChartDays as buildChartDaysUtil} from "../../utils/functionsGeneral";
// import type { ChartDay } from "../../utils/functionsGeneral";

interface Props {
  title?: string;
  trades: Trade[];
  initialBalance: number;
}

const {
  title = "Rendimiento por día",
  trades,
  initialBalance,
} = Astro.props as Props;

const daysAverages = getDayAverage(trades, initialBalance);

function getCellClass(value: number | null): string {
  const base =
    "w-full rounded-t-sm relative group transition-all duration-300";

  // No existen datos
  if (value === null) {
    return `${base} bg-transparent border-2 border-dashed border-gray-300`;
  }

  // Existen datos, pero el rendimiento fue 0%
  if (value === 0) {
    return `${base} bg-gray-500`;
  }

  // Rendimiento negativo 
  if (value < 0) {
    return `${base} bg-red-500`;
  }

  // Rendimiento positivo
  return `${base} bg-green-500`;
}

const chartDays = createChartDays(daysAverages);

---

<div class="bg-surface-container-low rounded-xl p-6 h-80 flex flex-col">
  <h4 class="text-sm font-bold mb-6">
    {title}
  </h4>

  <div class="flex-1 flex items-end gap-2 px-2">
  {
    chartDays.map((item) => (
      <div class="flex-1 h-full flex items-end relative group">
        <div
          class={getCellClass(item.average)}
          style={`height: ${item.height}%; min-height: 4px;`}
        >
          <div
            class="
              absolute
              left-1/2
              bottom-full
              -translate-x-1/2
              mb-2
              z-20
              whitespace-nowrap
              rounded-md
              bg-surface-container-highest
              px-3
              py-2
              text-xs
              text-on-surface
              shadow-lg
              opacity-0
              pointer-events-none
              transition-opacity
              duration-200
              group-hover:opacity-100
            "
          >
            {
              item.average === null ? (
                <>
                  <div class="font-bold">{item.label}: sin datos</div>
                  <div>{item.observations} observaciones</div>
                </>
              ) : (
                <>
                  <div class="font-bold">
                    {item.label}: {item.average.toFixed(2)}%
                  </div>

                  <div>
                    {item.observations} observaciones
                  </div>
                </>
              )
            }
          </div>
        </div>
      </div>
    ))
  }
</div>

  <div
    class="grid grid-cols-5 gap-2 px-2 text-[10px] text-on-surface-variant mt-4 font-bold uppercase tracking-widest text-center"
  >
    {
      chartDays.map((item) => (
        <span>{item.label}</span>
      ))
    }
  </div>
</div>

