---
interface Props {
  parametro1?: string;
  parametro2?: string;
  parametro3?: string;
  parametro4?: string;
  title?: string;
  parametro1Value?: string;
  parametro2Value?: string;
  parametro3Value?: string;
  parametro4Value?: string;
}

const {
  parametro1Value = "42.4%",
  parametro2Value = "+8.2%",
  parametro3Value,
  parametro4Value = "68.2%",
  parametro1 = "Retorno Total",
  parametro2 = "Mejor Mes",
  parametro3,
  parametro4 = "Tiempo en Mercado",
  title = "Análisis de Retornos",
} = Astro.props as Props;


const metrics = [
  {
    label: parametro1,
    value: parametro1Value,
    valueClass: "text-secondary",
  },
  {
    label: parametro2,
    value: parametro2Value,
    valueClass: "",
  },
  {
    label: parametro3,
    value: parametro3Value,
    valueClass: "text-tertiary",
  },
  {
    label: parametro4,
    value: parametro4Value,
    valueClass: "",
  },
].filter(({ label, value }) => {
  return label !== undefined && value !== undefined;
});


const hasThreeMetrics = metrics.length === 3;
---

<!-- Returns Analytics -->
<div 
class="bg-surface-container-low rounded-xl pt-4 pb-5 px-3
grid gap-4 self-start h-[200px] 

"

>
  <h4
    class="text-primary text-xs font-black uppercase tracking-widest pb-2"
  >
    {title}
  </h4>
<!-- class="grid gap-3" -->
  <div 
    class:list={[
    "grid gap-3",
    metrics.length === 3 ? "pb-4" : "",
  ]}
  >
    {
      metrics.map(({ label, value, valueClass }) => (
        <div class="flex items-center justify-between gap-3">
          <span class="text-sm text-on-surface-variant">
            {label}
          </span>

          <span
            class:list={[
              "text-sm font-bold",
              valueClass,
            ]}
          >
            {value}
          </span>
        </div>
      ))
    }
  </div>
</div>
