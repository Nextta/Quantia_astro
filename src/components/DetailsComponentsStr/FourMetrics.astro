  <!-- Returns Analytics -->
  <div class="bg-surface-container-low rounded-xl p-5">
    <h4 class="text-primary text-xs font-black uppercase tracking-widest mb-4">
      Análisis de Retornos
    </h4>
    <div class="space-y-3">
      <div class="flex justify-between items-center group/item cursor-default">
        <span
          class="text-sm text-on-surface-variant group-hover/item:text-on-surface transition-colors"
          >Retorno Total</span
        >
        <span class="text-sm font-bold text-secondary">42.4%</span>
      </div>
      <div class="flex justify-between items-center group/item cursor-default">
        <span
          class="text-sm text-on-surface-variant group-hover/item:text-on-surface transition-colors"
          >Mejor Mes</span
        >
        <span class="text-sm font-bold">+8.2%</span>
      </div>
      <div class="flex justify-between items-center group/item cursor-default">
        <span
          class="text-sm text-on-surface-variant group-hover/item:text-on-surface transition-colors"
          >Peor Mes</span
        >
        <span class="text-sm font-bold text-tertiary">-4.1%</span>
      </div>
      <div class="flex justify-between items-center group/item cursor-default">
        <span
          class="text-sm text-on-surface-variant group-hover/item:text-on-surface transition-colors"
          >Tiempo en Mercado</span
        >
        <span class="text-sm font-bold">68.2%</span>
      </div>
    </div>
  </div>

