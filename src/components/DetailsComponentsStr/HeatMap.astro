---
import type { Trade } from '../../interfaces/trades'; 

interface Props {
  trades: Trade[];
  title?: string;
  lossLabel?: string;
  neutralLabel?: string;
  profitLabel?: string;
  finalParameter?: string;
}

interface YearRow {
  year: number;
  months: Array<number | null>;
  ytd: number;
}

const {
  trades,
  title = "Mapa de Calor de Rendimiento Mensual",
  lossLabel = "Pérdida",
  neutralLabel = "Neutral",
  profitLabel = "Ganancia",
  finalParameter = "YTD",
} = Astro.props;

const monthNames = [
  "Ene",
  "Feb",
  "Mar",
  "Abr",
  "May",
  "Jun",
  "Jul",
  "Ago",
  "Sep",
  "Oct",
  "Nov",
  "Dic",
];

const monthlyTotals = new Map<string, number>();

// Guardamos todos los años encontrados en los trades.
const years = new Set<number>();
// interface Props {
//   title?: string;
//   PercentM1Y1?: number;
//   PercentM1Y2?: number;
//   PercentM2Y1?: number;
//   PercentM2Y2?: number;
//   PercentM3Y1?: number;
//   PercentM3Y2?: number;
//   PercentM4Y1?: number;
//   PercentM4Y2?: number;
//   PercentM5Y1?: number;
//   PercentM5Y2?: number;
//   PercentM6Y1?: number;
//   PercentM6Y2?: number;
//   PercentM7Y1?: number;
//   PercentM7Y2?: number;
//   PercentM8Y1?: number;
//   PercentM8Y2?: number;
//   PercentM9Y1?: number;
//   PercentM9Y2?: number;
//   PercentM10Y1?: number;
//   PercentM10Y2?: number;
//   PercentM11Y1?: number;
//   PercentM11Y2?: number;
//   PercentM12Y1?: number;
//   PercentM12Y2?: number;
//   YTDYear1?: number;
//   YTDYear2?: number;
//   Perdida?: string;
//   Neutral?: string;
//   Ganancia?: string;
//   FinalParameter?: string;
// }

for (const trade of trades) {
  if (!trade.t0) continue;

  // Extrae el año y el mes de "2023-11-23 09:15:00".
  const dateMatch = /^(\d{4})-(\d{2})/.exec(trade.t0);

  if (!dateMatch) continue;

  const year = Number(dateMatch[1]);
  const month = Number(dateMatch[2]);

  if (month < 1 || month > 12) continue;

  years.add(year);

  const key = `${year}-${month}`;

  // Number() permite manejar el caso en que SQLite entregue pl como texto.
  const parsedPL = Number(trade.pl ?? 0);
  const tradePL = Number.isFinite(parsedPL) ? parsedPL : 0;

  const currentTotal = monthlyTotals.get(key) ?? 0;

  // console.log("Trades por mes: ",currentTotal);

  monthlyTotals.set(key, currentTotal + tradePL);

  
  console.log("Trades por mes: ",monthlyTotals);
}

/*
 * Creamos una fila por cada año.
 * Los años aparecen del más reciente al más antiguo.
 */
const yearRows: YearRow[] = Array.from(years)
  .sort((a, b) => b - a)
  .map((year) => {
    const months = Array.from({ length: 12 }, (_, index) => {
      const month = index + 1;
      const key = `${year}-${month}`;

      // null significa que ese mes no tuvo trades.
      return monthlyTotals.has(key)
        ? monthlyTotals.get(key)!
        : null;
    });

    const ytd = months.reduce<number>(
      (total, monthPL) => total + (monthPL ?? 0),
      0,
    );

    return {
      year,
      months,
      ytd,
    };
  });

function formatPL(value: number | null): string {
  if (value === null) {
    return "—";
  }

  // Evita mostrar valores como "-0.0%".
  const normalizedValue = Math.abs(value) < 0.05 ? 0 : value;
  const sign = normalizedValue > 0 ? "+" : "";

  return `${sign}${normalizedValue.toFixed(1)}%`;
}

function getCellClass(
  value: number | null,
  isYtd = false,
): string {
  const base =
    "p-3 rounded-lg text-center whitespace-nowrap font-medium";

  if (value === null || value === 0) {
    return `${base} bg-surface-container-lowest text-on-surface`;
  }

  if (value > 0) {
    return isYtd
      ? `${base} bg-[#53ff30] text-on-secondary font-bold`
      : `${base} bg-secondary/80 text-on-secondary`;
  }

  return isYtd
    ? `${base} bg-[#f55b5b] text-on-tertiary font-bold`
    : `${base} bg-tertiary/60 text-on-tertiary`;
}


---

<div class="bg-surface-container-high rounded-xl p-6 mb-8">
  <div class="flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center mb-6">
    <h3 class="text-lg font-bold font-headline">
      {title}
    </h3>
    <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs font-medium text-on-surface-variant">
      <div class="flex items-center gap-1">
        <div class="w-3 h-3 bg-tertiary rounded-sm"></div> {lossLabel}
      </div>
      <div class="flex items-center gap-1">
        <div class="w-3 h-3 bg-surface-container-lowest rounded-sm"></div> {neutralLabel}
      </div>
      <div class="flex items-center gap-1">
        <div class="w-3 h-3 bg-secondary rounded-sm"></div> {profitLabel}
      </div>
    </div>
  </div>
  <div class="overflow-x-auto no-scrollbar">
    <table class="w-full text-left border-separate border-spacing-2">
      <thead>
        <tr
          class="text-[10px] text-on-surface-variant uppercase tracking-widest font-bold"
        >
          <th class="p-2">Año</th>
          {
            monthNames.map((monthName)=>(
              <th class="min-w-24">{monthName}</th>
            ))
          }
          <th class="p-2 bg-surface-container-highest rounded">{finalParameter}</th>
        </tr>
      </thead>
      <tbody class="text-sm font-medium">
        {
          yearRows.map((row)=>(
            <tr>
              <td class="p-2 text-primary font-bold">
                {row.year}
              </td>

              {row.months.map((monthPL) => (
                <td class={getCellClass(monthPL)}>
                  {formatPL(monthPL)}
                </td>
              ))}

              <td class={getCellClass(row.ytd, true)}>
                {formatPL(row.ytd)}
              </td>
            </tr>
          ))
        }
        {
          yearRows.length === 0 && (
            <tr>
              <td
                colspan="14"
                class="p-6 text-center text-on-surface-variant"
              >
                No hay trades disponibles para este backtesting.
              </td>
            </tr>
          )
        }
      
      </tbody>
    </table>
  </div>
</div>
