---
interface Props {
  title?: string;
  PercentM1Y1?: number;
  PercentM1Y2?: number;
  PercentM2Y1?: number;
  PercentM2Y2?: number;
  PercentM3Y1?: number;
  PercentM3Y2?: number;
  PercentM4Y1?: number;
  PercentM4Y2?: number;
  PercentM5Y1?: number;
  PercentM5Y2?: number;
  PercentM6Y1?: number;
  PercentM6Y2?: number;
  PercentM7Y1?: number;
  PercentM7Y2?: number;
  PercentM8Y1?: number;
  PercentM8Y2?: number;
  PercentM9Y1?: number;
  PercentM9Y2?: number;
  PercentM10Y1?: number;
  PercentM10Y2?: number;
  PercentM11Y1?: number;
  PercentM11Y2?: number;
  PercentM12Y1?: number;
  PercentM12Y2?: number;
  YTDYear1?: number;
  YTDYear2?: number;
  Perdida?: string;
  Neutral?: string;
  Ganancia?: string;
  FinalParameter?: string;
}

const { title = "Mapa de Calor de Rendimiento Mensual", PercentM1Y1=-1.2, PercentM1Y2=-6.7, PercentM2Y1=2.4, PercentM2Y2=1.1, PercentM3Y1=5.8, PercentM3Y2=-2.4, PercentM4Y1=3.9, PercentM4Y2=-4.5, PercentM5Y1=1.5, PercentM5Y2=0.0, PercentM6Y1=6, PercentM6Y2=2.1, PercentM7Y1=0.5, PercentM7Y2=0.8, PercentM8Y1=-0.2, PercentM8Y2=-0.5, PercentM9Y1=4.4, PercentM9Y2=5.2, PercentM10Y1=-1.5, PercentM10Y2=1.8, PercentM11Y1=0.9, PercentM11Y2=0.4, PercentM12Y1=2.2, PercentM12Y2=2.9, YTDYear1= 20, YTDYear2=-22, Perdida="Perdida", Neutral="Neutral", Ganancia="Ganancia", FinalParameter="YTD" } = Astro.props as Props;

---

<div class="bg-surface-container-high rounded-xl p-6 mb-8">
  <div class="flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center mb-6">
    <h3 class="text-lg font-bold font-headline">
      {title}
    </h3>
    <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs font-medium text-on-surface-variant">
      <div class="flex items-center gap-1">
        <div class="w-3 h-3 bg-tertiary rounded-sm"></div> {Perdida}
      </div>
      <div class="flex items-center gap-1">
        <div class="w-3 h-3 bg-surface-container-lowest rounded-sm"></div> {Neutral}
      </div>
      <div class="flex items-center gap-1">
        <div class="w-3 h-3 bg-secondary rounded-sm"></div> {Ganancia}
      </div>
    </div>
  </div>
  <div class="overflow-x-auto no-scrollbar">
    <table class="w-full text-left border-separate border-spacing-2">
      <thead>
        <tr
          class="text-[10px] text-on-surface-variant uppercase tracking-widest font-bold"
        >
          <th class="p-2">Año</th>
          <th>Ene</th><th>Feb</th><th>Mar</th><th>Abr</th><th>May</th><th
            >Jun</th
          >
          <th>Jul</th><th>Ago</th><th>Sep</th><th>Oct</th><th>Nov</th><th
            >Dic</th
          >
          <th class="p-2 bg-surface-container-highest rounded">{FinalParameter}</th>
        </tr>
      </thead>
      <tbody class="text-sm font-medium">
        <tr>
          <td class="p-2 text-primary font-bold">2023</td>
          <td
            class={PercentM1Y2 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{ 
            PercentM1Y2 > 0 ? `+${PercentM1Y2}%` : `${PercentM1Y2}%`
          }</td
          >
          <td  class={PercentM2Y2 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM2Y2 > 0 ? `+${PercentM2Y2}%` : `${PercentM2Y2}%`}</td
          >
          <td  class={PercentM3Y2 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM3Y2 > 0 ? `$+{PercentM3Y2}%` : `${PercentM3Y2}%`}</td
          >
          <td
             class={PercentM4Y2 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM4Y2 > 0 ? `+${PercentM4Y2}%` : `${PercentM4Y2}%`}</td
          >
          <td
            class={PercentM5Y2 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM5Y2 > 0 ? `+${PercentM5Y2}%` : `${PercentM5Y2}%`}</td
          >
          <td
            class={PercentM6Y2 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM6Y2 > 0 ? `+${PercentM6Y2}%` : `${PercentM6Y2}%`}</td
          >
          <td class={PercentM7Y2 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM7Y2 > 0 ? `+${PercentM7Y2}%` : `${PercentM7Y2}%`}</td
          >
          <td class={PercentM8Y2 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM8Y2 > 0 ? `+${PercentM8Y2}%` : `${PercentM8Y2}%`}</td
          >
          <td class={PercentM9Y2 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM9Y2 > 0 ? `+${PercentM9Y2}%` : `${PercentM9Y2}%`}</td
          > 
          <td
            class={PercentM10Y2 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM10Y2 > 0 ? `+${PercentM10Y2}%` : `${PercentM10Y2}%`}</td
          >
          <td class={PercentM11Y2 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM11Y2 > 0 ? `+${PercentM11Y2}%` : `${PercentM11Y2}%`}</td
          >
          <td
            class={PercentM12Y2 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM12Y2 > 0 ? `+${PercentM12Y2}%` : `${PercentM12Y2}%`}</td
          >
          <td
            class={YTDYear2 > 0 ? "bg-[#53ff30] text-on-secondary p-3 rounded-lg text-center font-bold" : "bg-[#f55b5b] text-on-tertiary p-3 rounded-lg text-center font-bold"}
            >{YTDYear2 > 0 ? `+${YTDYear2}%` : `${YTDYear2}%`}</td
          >
        </tr>
        <tr>
          <td class="p-2 text-primary font-bold">2022</td>
          <td class={PercentM1Y1 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM1Y1 > 0 ? `+${PercentM1Y1}%` : `${PercentM1Y1}%`}</td
          >
          <td
            class={PercentM2Y1 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM2Y1 > 0 ? `+${PercentM2Y1}%` : `${PercentM2Y1}%`}</td
          >
          <td class={PercentM3Y1 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM3Y1 > 0 ? `+${PercentM3Y1}%` : `${PercentM3Y1}%`}</td
          >
          <td class={PercentM4Y1 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM4Y1 > 0 ? `+${PercentM4Y1}%` : `${PercentM4Y1}%`}</td
          >
          <td class={PercentM5Y1 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM5Y1 > 0 ? `+${PercentM5Y1}%` : `${PercentM5Y1}%`}</td
          >
          <td class={PercentM6Y1 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM6Y1 > 0 ? `+${PercentM6Y1}%` : `${PercentM6Y1}%`}</td
          >
          <td class={PercentM7Y1 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM7Y1 > 0 ? `+${PercentM7Y1}%` : `${PercentM7Y1}%`}</td
          >
          <td class={PercentM8Y1 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM8Y1 > 0 ? `+${PercentM8Y1}%` : `${PercentM8Y1}%`}</td
          >
          <td
            class={PercentM9Y1 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM9Y1 > 0 ? `+${PercentM9Y1}%` : `${PercentM9Y1}%`}</td
          >
          <td class={PercentM10Y1 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM10Y1 > 0 ? `+${PercentM10Y1}%` : `${PercentM10Y1}%`}</td
          >
          <td class={PercentM11Y1 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM11Y1 > 0 ? `+${PercentM11Y1}%` : `${PercentM11Y1}%`}</td
          >
          <td
            class={PercentM12Y1 > 0 ? "bg-secondary/80 text-on-secondary p-3 rounded-lg text-center" : "bg-tertiary/60 text-on-tertiary p-3 rounded-lg text-center"}
            >{PercentM12Y1 > 0 ? `+${PercentM12Y1}%` : `${PercentM12Y1}%`}</td
          >
          <td
            class={YTDYear1 > 0 ? "bg-[#53ff30] text-on-secondary p-3 rounded-lg text-center font-bold" : "bg-[#f55b5b] text-on-tertiary p-3 rounded-lg text-center font-bold"}
            >{YTDYear1 > 0 ? `+${YTDYear1}%` : `${YTDYear1}%`}</td
          >
        </tr>
      </tbody>
    </table>
  </div>
</div>
