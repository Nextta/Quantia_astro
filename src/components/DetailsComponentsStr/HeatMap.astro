---

<div class="bg-surface-container-high rounded-xl p-6 mb-8">
  <div
    class="flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center mb-6"
  >
    <h3 class="text-lg font-bold font-headline">
      {title}
    </h3>
    <div
      class="flex flex-wrap gap-x-4 gap-y-1 text-xs font-medium text-on-surface-variant"
    >
      <div class="flex items-center gap-1">
        <div class="w-3 h-3 bg-tertiary rounded-sm"></div>
        {lossLabel}
      </div>
      <div class="flex items-center gap-1">
        <div class="w-3 h-3 bg-surface-container-lowest rounded-sm"></div>
        {neutralLabel}
      </div>
      <div class="flex items-center gap-1">
        <div class="w-3 h-3 bg-secondary rounded-sm"></div>
        {profitLabel}
      </div>
    </div>
  </div>
  <div class="overflow-x-auto no-scrollbar">
    <table class="w-full text-left border-separate border-spacing-2">
      <thead>
        <tr
          class="text-[10px] text-on-surface-variant uppercase tracking-widest font-bold"
        >
          <th class="p-2">Año</th>
          {monthNames.map((monthName) => <th class="min-w-24">{monthName}</th>)}
          <th class="p-2 bg-surface-container-highest rounded"
            >{finalParameter}</th
          >
        </tr>
      </thead>
      <tbody class="text-sm font-medium">
        {
          yearRows.map((row) => (
            <tr>
              <td class="p-2 text-primary font-bold">{row.year}</td>

              {row.months.map((monthPL) => (
                <td class={getCellClass(monthPL)}>{formatPL(monthPL)}</td>
              ))}

              <td class={getCellClass(row.ytd, true)}>{formatPL(row.ytd)}</td>
            </tr>
          ))
        }
        {
          yearRows.length === 0 && (
            <tr>
              <td colspan="14" class="p-6 text-center text-on-surface-variant">
                No hay trades disponibles para este backtesting.
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>
</div>
