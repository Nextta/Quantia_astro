---
interface Props {
  title?: string;
  Value1?: number;
  Value2?: number;
  Value3?: number;
  Parametro1?: string;
  Parametro2?: string;
  Parametro3?: string;
}

const {
  title = "Estrategia vs Benchmark",
  Value1 = 0.64,
  Value2 = 4.2,
  Value3 = 0.42,
  Parametro1 = "Beta",
  Parametro2 = "Alpha",
  Parametro3 = "Correlación",
} = Astro.props as Props;
---

<div class="bg-surface-container-low rounded-xl p-6 h-80 flex flex-col">
  <h4 class="text-sm font-bold mb-6">{title}</h4>
  <div class="space-y-6 flex-1 justify-center flex flex-col">
    <div>
      <div class="flex justify-between text-[10px] uppercase font-bold mb-2">
        <span>{Parametro1}</span>
        <span class="text-primary">{Value1}</span>
      </div>
      <div
        class="h-2 bg-surface-container-highest rounded-full overflow-hidden"
      >
        <div class="h-full bg-primary"
        style={`width: ${Math.min(Math.abs(75), 100)}%;`}
        ></div>
      </div>
    </div>
    <div>
      <div class="flex justify-between text-[10px] uppercase font-bold mb-2">
        <span>{Parametro2}</span>
        <span class="text-secondary">{Value2}%</span>
      </div>
      <div
        class="h-2 bg-surface-container-highest rounded-full overflow-hidden"
      >
        <div class="h-full bg-secondary"
        style={`width: ${Math.min(Math.abs(75), 100)}%;`}
        ></div>
      </div>
    </div>
    <div>
      <div class="flex justify-between text-[10px] uppercase font-bold mb-2">
        <span>{Parametro3}</span>
        <span class="text-on-surface-variant">{Value3}</span>
      </div>
      <div
        class="h-2 bg-surface-container-highest rounded-full overflow-hidden"
      >
        <div class="h-full bg-red-400"
        style={`width: ${Math.min(Math.abs(75), 100)}%;`}
        ></div>
      </div>
    </div>
  </div>
</div>
