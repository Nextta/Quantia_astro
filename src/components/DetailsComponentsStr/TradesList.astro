<div class="bg-surface-container-high rounded-xl overflow-hidden mb-8">
  <div class="px-6 py-4 flex justify-between items-center">
    <h3 class="text-lg font-bold font-headline">
      Actividad Reciente de Ejecución
    </h3>
    <span class="text-xs text-on-surface-variant"
      >Últimos 10 trades realizados</span
    >
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead>
        <tr
          class="bg-surface-container-low text-[10px] text-on-surface-variant uppercase tracking-widest font-black"
        >
          <th class="px-6 py-3">Fecha</th>
          <th class="px-6 py-3">Lado</th>
          <th class="px-6 py-3 text-right">Entrada</th>
          <th class="px-6 py-3 text-right">Salida</th>
          <th class="px-6 py-3 text-center">Resultado (%)</th>
          <th class="px-6 py-3 text-right">Resultado ($)</th>
          <th class="px-6 py-3">Duración</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-surface-container">
        <tr class="hover:bg-surface-bright transition-colors">
          <td class="px-6 py-4 font-medium">2023-11-24 14:22</td>
          <td class="px-6 py-4"
            ><span
              class="px-2 py-1 bg-secondary/10 text-secondary text-[10px] font-bold rounded"
              >LONG</span
            ></td
          >
          <td class="px-6 py-4 text-right tabular-nums">42,452.12</td>
          <td class="px-6 py-4 text-right tabular-nums">43,122.50</td>
          <td class="px-6 py-4 text-center text-secondary font-bold">+1.58%</td>
          <td class="px-6 py-4 text-right font-bold">+$12,420</td>
          <td class="px-6 py-4 text-on-surface-variant">4h 12m</td>
        </tr>
        <tr class="hover:bg-surface-bright transition-colors">
          <td class="px-6 py-4 font-medium">2023-11-23 09:15</td>
          <td class="px-6 py-4"
            ><span
              class="px-2 py-1 bg-tertiary/10 text-tertiary text-[10px] font-bold rounded"
              >SHORT</span
            ></td
          >
          <td class="px-6 py-4 text-right tabular-nums">41,200.00</td>
          <td class="px-6 py-4 text-right tabular-nums">41,450.25</td>
          <td class="px-6 py-4 text-center text-tertiary font-bold">-0.61%</td>
          <td class="px-6 py-4 text-right font-bold text-tertiary">-$4,200</td>
          <td class="px-6 py-4 text-on-surface-variant">1d 2h</td>
        </tr>
        <tr class="hover:bg-surface-bright transition-colors">
          <td class="px-6 py-4 font-medium">2023-11-21 11:45</td>
          <td class="px-6 py-4"
            ><span
              class="px-2 py-1 bg-secondary/10 text-secondary text-[10px] font-bold rounded"
              >LONG</span
            ></td
          >
          <td class="px-6 py-4 text-right tabular-nums">40,150.00</td>
          <td class="px-6 py-4 text-right tabular-nums">40,920.00</td>
          <td class="px-6 py-4 text-center text-secondary font-bold">+1.92%</td>
          <td class="px-6 py-4 text-right font-bold">+$15,800</td>
          <td class="px-6 py-4 text-on-surface-variant">8h 45m</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
