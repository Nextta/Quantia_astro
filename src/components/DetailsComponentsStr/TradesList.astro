---

<div class="bg-surface-container-high rounded-xl overflow-hidden mb-8">
  <div class="px-6 py-4 flex justify-between items-center">
    <h3 class="text-lg font-bold font-headline">
      {title}
    </h3>
    <span class="text-xs text-on-surface-variant"
      >Últimos {tradesPerPage} trades realizados</span
    >
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead>
        <tr
          class="bg-surface-container-low text-[10px] text-on-surface-variant uppercase tracking-widest font-black"
        >
          <th class="px-6 py-3">Fecha</th>
          <th class="px-6 py-3">Lado</th>
          <th class="px-6 py-3 text-right">Entrada</th>
          <th class="px-6 py-3 text-right">Salida</th>
          <th class="px-6 py-3 text-center">Resultado (%)</th>
          <th class="px-6 py-3 text-right">Resultado ($)</th>
          <th class="px-6 py-3">Duración</th>
          <th class="px-4 py-3 w-12 text-center">Descargar</th>
        </tr>
      </thead>

      <tbody class="divide-y divide-surface-container">
        {
          trades.map((trade) => (
            <tr class="hover:bg-surface-bright transition-colors">
              <td class="px-6 py-4 font-medium">{trade.date}</td>
              <td class="px-6 py-4">
                <span
                  class={`px-2 py-1 text-[10px] font-bold rounded ${
                    trade.side === "LONG"
                      ? "bg-secondary/10 text-secondary"
                      : "bg-tertiary/10 text-tertiary"
                  }`}
                >
                  {trade.side}
                </span>
              </td>
              <td class="px-6 py-4 text-right tabular-nums">
                {trade.entryPrice.toLocaleString("en-US", {
                  minimumFractionDigits: 2,
                })}
              </td>
              <td class="px-6 py-4 text-right tabular-nums">
                {trade.exitPrice.toLocaleString("en-US", {
                  minimumFractionDigits: 2,
                })}
              </td>
              <td
                class={`px-6 py-4 text-center font-bold ${trade.resultPercentage >= 0 ? "text-secondary" : "text-tertiary"}`}
              >
                {trade.resultPercentage >= 0 ? "+" : ""}
                {trade.resultPercentage}%
              </td>
              <td
                class={`px-6 py-4 text-right font-bold ${trade.resultAmount >= 0 ? "" : "text-tertiary"}`}
              >
                {trade.resultAmount >= 0 ? "+" : ""}$
                {Math.abs(trade.resultAmount).toLocaleString()}
              </td>
              <td class="px-6 py-4 text-on-surface-variant">
                {trade.duration}
              </td>
              <td class="px-6 py-4 text-on-surface-variant">
                <a href={`/trades/1`}>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    class="w-4 h-4 mx-auto text-on-surface-variant"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M11 8v7H7l5 6 5-6h-4V8z" />
                    <path d="M19 3H5c-1.1 0-2 .9-2 2v7h2V5h14v7h2V5c0-1.1-.9-2-2-2" />
                  </svg>
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <!-- Paginación -->
    <div
      class="px-6 py-4 flex flex-col sm:flex-row justify-between items-center gap-3 border-t border-surface-container"
    >
      <span class="text-xs text-on-surface-variant">
        <span class="font-bold text-on-surface">{`1-${tradesPerPage}`}</span> de <span
          class="font-bold text-on-surface">{totalDeTrades}</span
        > trades
      </span>
      <div class="flex items-center gap-1">
        <button
          class="px-3 py-1.5 text-xs rounded-lg text-on-surface-variant hover:bg-surface-container-low transition-colors disabled:opacity-30"
          disabled
        >
          <span class="material-symbols-outlined text-sm">chevron_left</span>
        </button>

        <button
          class="px-3 py-1.5 text-xs rounded-lg text-on-surface-variant hover:bg-surface-container-low transition-colors"
        >
          <span class="material-symbols-outlined text-sm">chevron_right</span>
        </button>
      </div>
    </div>
  </div>
</div>
