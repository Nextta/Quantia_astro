---

import { getTrades, getOneBacktest} from "../../utils/functionsGeneral";
import { EntryDirection } from "../../enums/EntryDirection";
import type { Trade } from "../../interfaces/trades";
import type { Backtest } from "../../interfaces/backtest";

interface Props {
  id: number;
  title?: string;
  tradesPerPage?: number;
  Fecha?: string;
  Lado?: string;
  Entrada?: string;
  Salida?: string;
  ResultadoPercent?: string;
  ResultadoMoney?: string;
  Duración?: string;
  Ver?: string;
  trades: Trade[];
  backtest: Backtest;
}


const {
  id = Number(Astro.params),
  title = "Actividad Reciente de Ejecución",
  tradesPerPage = 10,
  Fecha = "Fecha",
  Lado = "Lado",
  Entrada = "Entrada",
  Salida = "Salida",
  ResultadoPercent = "Resultado (%)",
  ResultadoMoney = "Resultado ($)",
  Duración = "Duración",
  Ver = "Ver",
  trades,
  backtest
} = Astro.props as Props;

function getPages() {
  const pageSize = Math.max(1, Number(tradesPerPage) || 10); //Total de trades por pagina, minimo 1
  const totalTrades = trades.length; //Total de trades en el array
  const endIndex = Math.min(pageSize, totalTrades); //Total de trades a mostrar en la pagina actual, no puede ser mayor al total de trades

  const tradesToShow = trades.slice(0, endIndex); //Los trades a mostrar en la pagina actual, desde el inicio hasta el endIndex, donde el endIndex es el total de trades a mostrar en la pagina actual, no puede ser mayor al total de trades

  return {
    pageSize,
    totalTrades,
    endIndex,
    tradesToShow,
  };
}

const pages = getPages();

---

<div class="bg-surface-container-high rounded-xl overflow-hidden mb-8">
  <div class="px-6 py-4 flex justify-between items-center">
    <h3 class="text-lg font-bold font-headline">
      {title}
    </h3>
    <span class="text-xs text-on-surface-variant"
      >Últimos {tradesPerPage} trades realizados</span
    >
  </div>
  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead>
        <tr
          class="bg-surface-container-low text-[10px] text-on-surface-variant uppercase tracking-widest font-black"
        >
          <th class="px-6 py-3">{Fecha}</th>
          <th class="px-6 py-3">{Lado}</th>
          <th class="px-6 py-3 text-right">{Entrada}</th>
          <th class="px-6 py-3 text-right">{Salida}</th>
          <th class="px-6 py-3 text-center">{ResultadoPercent}</th>
          <th class="px-6 py-3 text-right">{ResultadoMoney}</th>
          <th class="px-6 py-3">{Duración}</th>
          <th class="px-4 py-3 w-12 text-center">{Ver}</th>
        </tr>
      </thead>

      <tbody class="divide-y divide-surface-container">
        {
        trades.map((tr, index)=> (
            <tr 
            data-trade-row
            // data-index={index}
            hidden={index >= pages.pageSize}
            class="hover:bg-surface-bright transition-colors">
              <td class="px-6 py-4 font-medium">{tr.t0}</td>
              <td class="px-6 py-4">
                <span
                  class={`px-2 py-1 text-[10px] font-bold rounded ${
                    tr.tipo === EntryDirection.Buy
                      ? "bg-secondary/10 text-secondary"
                      : "bg-tertiary/10 text-tertiary"
                  }`}
                >
                  {tr.tipo}                </span>
              </td>
              <td class="px-6 py-4 text-right tabular-nums">
                {tr.precio_entrada.toLocaleString("en-US", {
                  minimumFractionDigits: 2, maximumFractionDigits: 2
                })}
              </td>
              <td class="px-6 py-4 text-right tabular-nums">
                {tr.precio_cierre.toLocaleString("en-US", {
                  minimumFractionDigits: 2, maximumFractionDigits: 2
                })}
              </td>
              
              <td
                class={`px-6 py-4 text-center font-bold ${tr.pl >= 0 ? "text-secondary" : "text-tertiary" }`}
              >
                {((tr.pl * 100) / backtest.balance).toFixed(2)}%
              </td>
             
              <td
                
                 class={`px-6 py-4 text-right font-bold ${tr.pl  >= 0 ? "text-secondary" : "text-tertiary"}`}
                
              >
                {tr.pl >= 0 ? "+" : "-"}$
                {Math.abs(tr.pl).toLocaleString()}
              </td>
              <td class="px-6 py-4 text-on-surface-variant">
                {tr.duracion_horas}
              </td>
              <td class="px-6 py-4 text-on-surface-variant">
                <a href={`/strategies/${id}/trades/${tr.id}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"><!-- Icon from Material Symbols by Google - https://github.com/google/material-design-icons/blob/master/LICENSE --><path fill="#9d8585" d="M12 19q-3.375 0-6.125-1.687t-4.25-4.463q-.175-.325-.25-.662T1.3 11.5t.075-.687t.25-.663q1.5-2.775 4.25-4.462T12 4t6.125 1.688t4.25 4.462q.175.325.25.663t.075.687t-.075.688t-.25.662q-1.5 2.775-4.25 4.463T12 19m-7.375.9q-.25.275-.638.363T3.175 20q-.425-.375-.825-.8t-.725-.9q-.25-.35-.137-.712t.437-.563t.725-.162t.75.487q.25.35.538.625t.612.55q.35.3.338.7t-.263.675m6.35 2.075q-.05.375-.362.65t-.863.2q-.675-.1-1.338-.25T7.1 22.2q-.5-.175-.65-.575t-.025-.75t.463-.575t.787-.05q.625.225 1.263.363t1.287.237q.45.05.625.4t.125.725M12 16q1.875 0 3.188-1.312T16.5 11.5t-1.312-3.187T12 7T8.813 8.313T7.5 11.5t1.313 3.188T12 16m0-1.8q-1.125 0-1.912-.788T9.3 11.5t.788-1.912T12 8.8t1.913.788t.787 1.912t-.787 1.913T12 14.2m.975 7.775q-.05-.375.15-.725t.675-.4q.65-.1 1.275-.25t1.25-.375q.425-.15.763.075t.462.575t-.038.75t-.687.6q-.65.225-1.3.363t-1.325.237q-.55.075-.862-.2t-.363-.65m6.35-2.05q-.25-.275-.262-.687t.362-.713t.7-.637t.6-.738q.25-.35.638-.35t.687.225t.4.625t-.25.875q-.3.425-.638.775t-.737.7q-.425.35-.837.275t-.663-.35"/></svg>
                </a>
              </td>
            </tr>
         ))
        }
      </tbody>
    </table>

    <!-- Paginación -->
     <div
      id="tradeList"
      data-page-size={pages.pageSize}
>
    <div
      class="px-6 py-4 flex flex-col sm:flex-row justify-between items-center gap-3 border-t border-surface-container"
    >
      <span class="text-xs text-on-surface-variant">
        <span class="font-bold text-on-surface" id="rangeTrades">
          {trades.length === 0 ? "0" : `1-${pages.endIndex}`}
        </span> de <span
          class="font-bold text-on-surface">{trades.length}</span
        > trades
      </span>
      <div class="flex items-center gap-1">
        <button
          class="px-3 py-1.5 text-xs rounded-lg text-on-surface-variant hover:bg-surface-container-low transition-colors disabled:opacity-30 border-2" id="prevButton"
          disabled
        >
          <span class="material-symbols-outlined text-sm">chevron_left</span>
        </button>

        <button id="nextButton" type="button" 
          class="px-3 py-1.5 text-xs rounded-lg text-on-surface-variant hover:bg-surface-container-low transition-colors border-2"
          
          >
          <span class="material-symbols-outlined text-sm">chevron_right</span>
        </button>
      </div>
    </div>
  </div>
</div>
</div>
<script>
  // const pageSize =  10;
  let currentPage = 1;
  const tradeList = document.querySelector<HTMLElement>("#tradeList");
  const pageSize = Number(tradeList?.dataset.pageSize) || 10;

  const rows = document.querySelectorAll<HTMLTableRowElement>("[data-trade-row]");
  const totalTrades = rows.length;
  const totalPages = Math.ceil(totalTrades / pageSize);

  const buttonNext = document.querySelector<HTMLButtonElement>("#nextButton");
  const buttonPrev = document.querySelector<HTMLButtonElement>("#prevButton");
  const rangeTrades = document.querySelector<HTMLSpanElement>("#rangeTrades");



  function renderPage() {
    const startIndex = (currentPage - 1) * pageSize;
    const endIndex = Math.min(startIndex + pageSize, totalTrades);

    rows.forEach((row, index) => {
      row.hidden = index < startIndex || index >= endIndex;
    });

    if (rangeTrades) {
  rangeTrades.textContent = `${startIndex + 1}-${endIndex}`;
}

if (buttonPrev) {
  buttonPrev.disabled = currentPage === 1;
}

if (buttonNext) {
  buttonNext.disabled = currentPage >= totalPages;
}
  }

  buttonNext?.addEventListener("click", () => {
    if (currentPage < totalPages) {
      currentPage++;
      renderPage();
    }
  });

  buttonPrev?.addEventListener("click", () => {
    if (currentPage > 1) {
      currentPage--;
      renderPage();
    }
  });

  renderPage();
</script>