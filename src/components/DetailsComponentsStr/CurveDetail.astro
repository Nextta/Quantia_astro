---
var balanceInitial: number = 10000;
var balanceTotal: number = balanceInitial;

const points = [
  { time: "2025-01-01", value: balanceTotal },
  // { time: "2025-01-10", value: 0 },
  // { time: "2025-01-20", value: 0 },
];

//Balance actual
//PLN
function addProfit(pln: number, date: string) {
  // let total = balance + pln;
  balanceTotal += pln;
  points.push({ time: date, value: balanceTotal });
}

addProfit(40, "2025-01-02");
addProfit(40, "2025-01-03");
addProfit(40, "2025-01-04");
addProfit(-400, "2025-01-05");
addProfit(80, "2025-01-06");
addProfit(100, "2025-01-07");
addProfit(140, "2025-01-08");
addProfit(-50, "2025-01-09");

const tradeNumberF = new Map(
  points.map((point: { time: string; value: number }, index: number) => {
    return [point.time, index + 1];
  }),
);

// console.log(points);

const total = points.reduce((total: number, point: { value: number }) => {
  return (total += point.value);
}, 0);

const TradeNumber = points.length - 1;

interface Props {
  title?: string;
  moneyTotal?: number;
  porcentaje?: number;
  CAGR?: string;
}

const {
  title = "Curva de Equidad (Equity Curve)",
  moneyTotal = balanceTotal,
  porcentaje = 24.5,
  CAGR = "CAGR",
} = Astro.props as Props;
---

<div
  class="md:col-span-8 bg-surface-container-high rounded-xl p-6 relative overflow-hidden"
>
  <div class="flex justify-between items-start mb-8">
    <div>
      <h3 class="text-on-surface-variant text-sm font-medium mb-1">
        {title}
      </h3>
      <p class="text-2xl font-bold font-headline text-slate-50 tracking-tight">
        ${moneyTotal.toLocaleString()}
      </p>
    </div>

    <div class="flex gap-2">
      <span
        class="bg-secondary/10 text-secondary px-2 py-1 rounded text-[10px] font-bold"
      >
        +{porcentaje}% {CAGR}
      </span>
    </div>
  </div>

  <div
    class="equity-chart-root w-full"
    style="height: 256px;"
    data-balance-total={balanceTotal}
    data-balance-initial={balanceInitial}
    data-trade-number={TradeNumber}
  >
    <div class="equity-chart w-full h-full"></div>
    <script
      type="application/json"
      class="equity-chart-data"
      set:html={JSON.stringify(points)}
    />
  </div>
  <!-- <div 
    class="equity-chart-root"
    data-balance-total={balanceTotal}
  >
    <div class="equity-chart"></div>
  </div> -->
</div>

<script>
  import { createChart, AreaSeries, ColorType } from "lightweight-charts";

  function initEquityCharts() {
    const roots = document.querySelectorAll<HTMLElement>(".equity-chart-root");

    roots.forEach((root) => {
      if (root.dataset.initialized === "true") return;

      const container = root.querySelector<HTMLElement>(".equity-chart");
      const dataTag =
        root.querySelector<HTMLScriptElement>(".equity-chart-data");

      if (!container || !dataTag) return;

      const points = JSON.parse(dataTag.textContent || "[]");
      let acumulado: number = 0;
      // const equityPoints = points.map(
      //   (point: { time: string; value: number }) => {
      //     acumulado += point.value;
      //     return {
      //       time: point.time,
      //       value: acumulado,
      //     };
      //   },
      // );

      // const total = points.reduce((total: number, point: { value: number }) => {
      //   return (acumulado += point.value);
      // }, 0);

      // console.log("Total:", total);

      requestAnimationFrame(() => {
        var tradeNumber = new Map<string, number>(
          points.slice(1).map((point: { time: string }, index: number) => {
            return [point.time, index + 1];
          }),
        );

        const chart = createChart(container, {
          autoSize: true,
          layout: {
            background: {
              type: ColorType.Solid,
              color: "#1e293b",
            },
            textColor: "#cbd5e1",
          },
          grid: {
            vertLines: { color: "rgba(148, 163, 184, 0.10)" },
            horzLines: { color: "rgba(148, 163, 184, 0.10)" },
          },
          rightPriceScale: {
            visible: true,
            borderVisible: false,
          },
          leftPriceScale: {
            visible: false,
          },
          timeScale: {
            visible: true,
            borderVisible: false,
            ticksVisible: true,
            tickMarkFormatter: (time: string) => {
              const tradeN = tradeNumber.get(String(time));

              if (!tradeN) return "Initial Balance";

              return `| #${tradeN} - ${time} |`;
            },
          },
          localization: {
            priceFormatter: (price: number) => {
              return `$${price.toLocaleString()}`;
            },
          },

          handleScroll: false,
          handleScale: false,
        });

        const balance_Total = Number(root.dataset.balanceTotal);
        const balance_Initial = Number(root.dataset.balanceInitial);

        // console.log("Balance Initial:", balance_Initial);

        const series = chart.addSeries(AreaSeries, {
          lineColor: balance_Total > balance_Initial ? "#4edea3" : "#ef4444",
          topColor: "rgba(78, 222, 163, 0.30)",
          bottomColor: "rgba(78, 222, 163, 0.03)",
          lineWidth: 3,
          priceLineVisible: false,
          lastValueVisible: false,
          crosshairMarkerVisible: false,
        });
        // console.log(points);
        series.setData(points);
        chart.timeScale().fitContent();

        root.dataset.initialized = "true";
      });
    });
  }

  initEquityCharts();
  document.addEventListener("astro:page-load", initEquityCharts);
</script>
