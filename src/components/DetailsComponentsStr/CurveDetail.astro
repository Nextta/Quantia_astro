---
import type { Trade } from "../../interfaces/trades";
import { buildEquityCurve } from "../../utils/functionsGeneral";

interface Props {
  title?: string;
  initialBalance: number;
  trades: Trade[];
  porcentaje?: number;
  CAGR?: string;
}

const {
  title = "Curva de Equidad (Equity Curve)",
  initialBalance,
  trades,
  porcentaje = 24.5,
  CAGR = "CAGR",
} = Astro.props as Props;

const equityR = buildEquityCurve(trades, initialBalance);

console.log(equityR);

const { points, finalBalance, netProfit, tradeCount } = equityR;

const returnPercentage =
  initialBalance > 0 ? (netProfit / initialBalance) * 100 : 0;
---

<div
  class="md:col-span-8 bg-surface-container-high rounded-xl p-6 relative overflow-hidden"
>
  <div class="flex justify-between items-start mb-8">
    <div>
      <h3 class="text-on-surface-variant text-sm font-medium mb-1">
        {title}
      </h3>
      <p class="text-2xl font-bold font-headline text-slate-50 tracking-tight">
        ${finalBalance.toLocaleString()}
      </p>
    </div>

    <div class="flex gap-2">
      <span
        class:list={[
          "px-2 py-1 rounded text-[10px] font-bold",

          returnPercentage > 0 && "bg-secondary/10 text-secondary",

          returnPercentage < 0 && "bg-red-500/10 text-red-500",

          returnPercentage === 0 && "bg-gray-500/10 text-gray-400",
        ]}
      >
        {returnPercentage > 0 ? "+" : ""}
        {returnPercentage.toFixed(2)}% Return
      </span>
    </div>
  </div>

  <div
    class="equity-chart-root w-full"
    style="height: 256px;"
    data-final-balance={finalBalance}
    data-initial-balance={initialBalance}
  >
    <div class="equity-chart w-full h-full"></div>
    <script
      type="application/json"
      class="equity-chart-data"
      set:html={JSON.stringify(points)}
    />
  </div>
</div>

<script>
  import { createChart, AreaSeries, ColorType } from "lightweight-charts";

  function initEquityCharts() {
    const roots = document.querySelectorAll<HTMLElement>(".equity-chart-root");

    roots.forEach((root) => {
      if (root.dataset.initialized === "true") return;

      const container = root.querySelector<HTMLElement>(".equity-chart");

      const dataTag =
        root.querySelector<HTMLScriptElement>(".equity-chart-data");

      if (!container || !dataTag) return;

      const points = JSON.parse(dataTag.textContent || "[]");

      // console.log("Total:", total);

      requestAnimationFrame(() => {
        var tradeNumber = new Map<string, number>(
          points.slice(1).map((point: { time: string }, index: number) => {
            return [point.time, index + 1];
          }),
        );

        const chart = createChart(container, {
          autoSize: true,
          layout: {
            background: {
              type: ColorType.Solid,
              color: "#1e293b",
            },
            textColor: "#cbd5e1",
          },
          grid: {
            vertLines: { color: "rgba(148, 163, 184, 0.10)" },
            horzLines: { color: "rgba(148, 163, 184, 0.10)" },
          },
          rightPriceScale: {
            visible: true,
            borderVisible: false,
          },
          leftPriceScale: {
            visible: false,
          },
          timeScale: {
            visible: true,
            borderVisible: false,
            ticksVisible: true,
            tickMarkFormatter: (time: string) => {
              const tradeN = tradeNumber.get(String(time));

              if (!tradeN) return "Initial Balance";

              return `| #${tradeN} - ${time} |`;
            },
          },
          localization: {
            priceFormatter: (price: number) => {
              return `$${price.toLocaleString()}`;
            },
          },

          handleScroll: false,
          handleScale: false,
        });

        const finalBalance = Number(root.dataset.finalBalance);
        const initialBalance = Number(root.dataset.initialBalance);

        console.log({
          finalBalance,
          initialBalance,
        });

        // console.log("Balance Initial:", balance_Initial);
        const isProfitable = finalBalance >= initialBalance;
        const series = chart.addSeries(AreaSeries, {
          lineColor: isProfitable ? "#4edea3" : "#ef4444",

          topColor: isProfitable
            ? "rgba(78, 222, 163, 0.30)"
            : "rgba(239, 68, 68, 0.03)",
          bottomColor: isProfitable
            ? "rgba(78, 222, 163, 0.03)"
            : "rgba(239, 68, 68, 0.03)",
          lineWidth: 3,
          priceLineVisible: false,
          lastValueVisible: false,
          crosshairMarkerVisible: false,
        });
        // console.log(points);
        series.setData(points);
        chart.timeScale().fitContent();

        root.dataset.initialized = "true";
      });
    });
  }

  initEquityCharts();
  document.addEventListener("astro:page-load", initEquityCharts);
</script>
