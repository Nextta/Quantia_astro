---
import type { Trade } from "../../interfaces/trades";
import { buildEquityCurve } from "../../utils/functionsGeneral";

interface Props {
  title?: string;
  initialBalance: number;
  trades: Trade[];
  returnUSD: number;
  returnPercent: number;
  CAGR?: string;
}

const {
  title = "Curva de Equidad (Equity Curve)",
  initialBalance,
  trades,
  returnUSD,
  returnPercent,
  CAGR = "CAGR",
} = Astro.props as Props;

const equityR = buildEquityCurve(trades, initialBalance);

const { points, finalBalance } = equityR;


---

<div
  class="md:col-span-8 bg-surface-container-high rounded-xl p-6 relative overflow-hidden"
>
  <div class="flex justify-between items-start mb-8">
    <div>
      <h3 class="text-on-surface-variant text-sm font-medium mb-1">
        {title}
      </h3>
      <p class="text-2xl font-bold font-headline text-slate-50 tracking-tight">
        ${returnUSD} USD
      </p>
    </div>

    <div class="flex gap-2">
      <span
        class:list={[
          "px-2 py-1 rounded text-[10px] font-bold",

          returnPercent > 0 && "bg-secondary/10 text-secondary",

          returnPercent < 0 && "bg-red-500/10 text-red-500",

          returnPercent === 0 && "bg-gray-500/10 text-gray-400",
        ]}
      >
        {returnPercent > 0 ? "+" : ""}
        {returnPercent}% Return
      </span>
    </div>
  </div>

  <div
    class="equity-chart-root w-full"
    style="height: 256px;"
    data-final-balance={finalBalance}
    data-initial-balance={initialBalance}
  >
    <div class="equity-chart w-full h-full"></div>
    <script
      type="application/json"
      class="equity-chart-data"
      set:html={JSON.stringify(points)}
    ></script> 
  </div>
</div>

<script>
  import { createChart, BaselineSeries, ColorType } from "lightweight-charts";

  

  function initEquityCharts() {
    const roots = document.querySelectorAll<HTMLElement>(".equity-chart-root");

    roots.forEach((root) => {
      if (root.dataset.initialized === "true") return; //Evitamos crear el gráfico si ya se ha inicializado

      const container = root.querySelector<HTMLElement>(".equity-chart");

      const dataTag =
        root.querySelector<HTMLScriptElement>(".equity-chart-data"); // Obtenemos el elemento <script> que contiene los datos

      if (!container || !dataTag) return; // Si no encontramos el contenedor o el elemento de datos, salimos de la función

      const points = JSON.parse(dataTag.textContent || "[]"); // Parseamos los datos del elemento <script> a un arreglo de puntos

      requestAnimationFrame(() => {
        const tradeNumber = new Map<number, number>(
          points.slice(1).map((point: { time: number }, index: number) => {
            return [Number(point.time), index + 1];
          }),
        );

        const chart = createChart(container, {
          autoSize: true,
          layout: {
            background: {
              type: ColorType.Solid,
              color: "#1e293b",
            },
            textColor: "#cbd5e1",
          },
          grid: {
            vertLines: { color: "rgba(148, 163, 184, 0.10)" },
            horzLines: { color: "rgba(148, 163, 184, 0.10)" },
          },
          rightPriceScale: {
            visible: true,
            borderVisible: false,
          },
          leftPriceScale: {
            visible: false,
          },
          timeScale: {
            visible: true,
            borderVisible: false,
            ticksVisible: true,
              tickMarkMaxCharacterLength: 5,
            tickMarkFormatter: (time: number) => {
              const numericTime = Number(time);
              const tradeN = tradeNumber.get(numericTime);

              if (tradeN === undefined) {
                return "#0";
              }

              return `#${tradeN}`;
            },
          },
          localization: {
            priceFormatter: (money: number) => {
              return `$${money.toLocaleString()} USD`;
            },
          },

          handleScroll: true,
          handleScale: true,
        });

        const initialBalance = Number(root.dataset.initialBalance);

        const series = chart.addSeries(BaselineSeries, {
          baseValue: {
            type: "price",
            price: initialBalance,
          },

          topLineColor: "#4edea3",
          topFillColor1: "rgba(78, 222, 163, 0.30)",
          topFillColor2: "rgba(78, 222, 163, 0.03)",

          bottomLineColor: "#ef4444",
          bottomFillColor1: "rgba(239, 68, 68, 0.03)",
          bottomFillColor2: "rgba(239, 68, 68, 0.30)",

          lineWidth: 3,
          priceLineVisible: false,
          lastValueVisible: false,
          crosshairMarkerVisible: false,
        });
       

        

        series.setData(points);
        chart.timeScale().fitContent();

        root.dataset.initialized = "true";
      });
    });
  }

  initEquityCharts();
  document.addEventListener("astro:page-load", initEquityCharts);
</script>
