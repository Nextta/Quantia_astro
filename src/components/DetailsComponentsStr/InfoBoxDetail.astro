import type { resultados } from "../../interfaces/resultados"; 

interface Props {
  title?:  string;
  risk_of_ruin?: resultados["risk_of_ruin"];
  ratioLabel?: string;
}

const { title = "Risk of ruin--", risk_of_ruin = 1.82, ratioLabel = "Excepcional" } = Astro.props as Props;


---

<div
  class="bg-surface-container-high rounded-xl p-5 flex flex-col justify-center"
>
  <span
    class="text-on-surface-variant text-[11px] font-bold uppercase tracking-widest mb-1"
    >{title}</span
  >
  <div class="flex items-end gap-2">
    <span class={risk_of_ruin > 0 ? "text-4xl font-black text-primary font-headline" : "text-4xl font-black text-tertiary font-headline"}>{risk_of_ruin}</span>
    <span class="text-secondary text-xs font-medium mb-2">{ratioLabel}</span>
  </div>
</div>
