---
interface Props {
  title?: string;
  ratioValue?: number;
  ratioLabel?: string;
}

const { title = "Ratio de Sharpe", ratioValue = 1.82, ratioLabel = "Excepcional" } = Astro.props as Props;


---

<div
  class="bg-surface-container-high rounded-xl p-5 flex flex-col justify-center"
>
  <span
    class="text-on-surface-variant text-[11px] font-bold uppercase tracking-widest mb-1"
    >{title}</span
  >
  <div class="flex items-end gap-2">
    <span class="text-4xl font-black text-primary font-headline">{ratioValue}</span>
    <span class="text-secondary text-xs font-medium mb-2">{ratioLabel}</span>
  </div>
</div>
