---
import type { resultados } from '../../interfaces/resultados';

interface Props {
  factor1?: string;
  factor2?: string;
  recoveryFactor?: resultados["recovery_factor"];
  profitFactor?: resultados["profit_factor"];
}

const { recoveryFactor = -3.24, profitFactor = 1.65, factor1 = "Factor 1", factor2 = "Factor 2" } = Astro.props as Props;

---
<div class="bg-surface-container-low rounded-xl p-6 grid grid-cols-2 gap-4 border-0">
  <div>
    <span class="block text-[10px] text-on-surface-variant font-bold"
      >{factor1}</span
    >
    <span class={recoveryFactor > 0 ? "text-lg font-bold text-primary" : "text-lg font-bold text-tertiary"}>{recoveryFactor}</span>
  </div>
  <div>
    <span class="block text-[10px] text-on-surface-variant font-bold"
      >{factor2}</span
    >
    <span class={profitFactor > 0 ? "text-lg font-bold text-primary" : "text-lg font-bold text-tertiary"}>{profitFactor}</span>
  </div>
</div>
